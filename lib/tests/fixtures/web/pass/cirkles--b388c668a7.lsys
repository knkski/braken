# RESETIUS |   X=F[s][t];@.9F[s][t]@.85F[s][t]@.8F[s][t]@.75F[s][t]@.7F[s][t]@.65F[s][t]
# RESETIUS |   s=----<1F[s][t]-<5F[s][t]-<10F[s][t]-<10F[s][t]
# RESETIUS |   s=-F>10[s][t]-F>10[s][t]-F>5[s][t]-F>1[s][t]
# RESETIUS |   t=++++<1F[s][t]+<5F[s][t]+<10F[s][t]+<10F[s][t]
# RESETIUS |   t=+F>10[s][t]+F>10[s][t]+F>5[s][t]+F>1[s][t]
# RESETIUS |   F=<10F<10FFF>10F>10
# RESETIUS |   }
