let ANGLE = 24;

axiom TurnAround X;

match X then F [ S ] [ T ];
match S then Minus Minus Minus Minus ColorIncrement(1) F [ S ] [ T ] Minus ColorIncrement(5) F [ S ] [ T ] Minus ColorIncrement(10) F [ S ] [ T ] Minus ColorIncrement(10) F [ S ] [ T ] Minus F ColorIncrement(-10) [ S ] [ T ] Minus F ColorIncrement(-10) [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ] Minus F ColorIncrement(-1) [ S ] [ T ];
match T then Plus Plus Plus Plus ColorIncrement(1) F [ S ] [ T ] Plus ColorIncrement(5) F [ S ] [ T ] Plus ColorIncrement(10) F [ S ] [ T ] Plus ColorIncrement(10) F [ S ] [ T ] Plus F ColorIncrement(-10) [ S ] [ T ] Plus F ColorIncrement(-10) [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ] Plus F ColorIncrement(-1) [ S ] [ T ];
match F then ColorIncrement(10) F ColorIncrement(10) F F F ColorIncrement(-10) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
