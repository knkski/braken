let ANGLE = 90;

axiom Z;

match Z then X;
match X then Minus [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] Y F W Plus [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] X F W [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] X Plus F W [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] Y Minus;
match Y then Plus [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] X F W Minus [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] Y F W [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] Y Minus F W [ Color(40) Scale(0.5) G Plus F Plus Scale(2) F Plus F Plus F Plus Scale(0.5) F ] X Plus;
match W then F W;
match F then nothing;
match G then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
