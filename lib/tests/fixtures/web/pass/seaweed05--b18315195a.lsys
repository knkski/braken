#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Seaweed05 { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom f
# RESETIUS |   x=--<5F[X][y]++F>5[X][y]
# RESETIUS |   y=++<5F[X][y]--F>5[X][y]
# RESETIUS |   f=<10F[X][y]F>10
# RESETIUS |   }
#
let ANGLE = 12;

axiom F;

match X then Minus Minus ColorIncrement(5) F [ X ] [ Y ] Plus Plus F ColorIncrement(-5) [ X ] [ Y ];
match Y then Plus Plus ColorIncrement(5) F [ X ] [ Y ] Minus Minus F ColorIncrement(-5) [ X ] [ Y ];
match F then ColorIncrement(10) F [ X ] [ Y ] F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
