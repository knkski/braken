# FRACTINT | Kites&Darts2 {
# FRACTINT |                ;; by Philippe Hurbain
# FRACTINT |                ;; Penrose's kites and darts, with kites seed
# FRACTINT |   Angle 10
# FRACTINT |   Axiom [k]++[k]++[k]++[k]++[k]
# FRACTINT |   k=+[@.618034a]f@.618034---[-k]f-f---[-k]@i.618034f[@.618034|a]
# FRACTINT |   a=[@.618034k]+f@.618034[|a]----f+f----[a]@i.618034f
# FRACTINT |   f=g
# FRACTINT | }
#
let ANGLE = 36;

axiom [ K ] Plus Plus [ K ] Plus Plus [ K ] Plus Plus [ K ] Plus Plus [ K ];

match K then Plus [ Scale(0.618034) A ] F Scale(0.618034) Minus Minus Minus [ Minus K ] F Minus F Minus Minus Minus [ Minus K ] Scale(1.6180339593) F [ Scale(0.618034) TurnAround A ];
match A then [ Scale(0.618034) K ] Plus F Scale(0.618034) [ TurnAround A ] Minus Minus Minus Minus F Plus F Minus Minus Minus Minus [ A ] Scale(1.6180339593) F;
match F then G;
