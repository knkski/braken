let ANGLE = 45;

axiom Plus X;

match X then X Minus F Minus Y Minus F Minus X Plus F Plus Y Plus F Plus X Plus F Plus Y Minus F Minus X Minus F Minus Y;
match Y then X Plus F Plus Y Plus F Plus X Minus F Minus Y Minus F Minus X Minus F Minus Y Plus F Plus X Plus F Plus Y;
