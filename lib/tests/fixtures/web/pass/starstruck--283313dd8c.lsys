let ANGLE = 36;

axiom V;

match V then X;
match X then [ Minus Minus Minus F Y ] [ Minus F Z ] F Y Plus Plus F X Minus Minus Minus Minus F Y Plus Plus F X;
match Y then F Y Plus Plus F X Minus Minus Minus Minus F Y Plus Plus F X [ Minus Minus F Z ] [ Minus Minus Minus Minus F Y ];
match Z then F Z Minus Minus F W Plus Plus Plus Plus F Z Minus Minus F W [ Plus Plus F Y ] [ Plus Plus Plus Plus F Z ];
match W then [ Plus Plus Plus F Z ] [ Plus F Y ] F Z Minus Minus F W Plus Plus Plus Plus F Z Minus Minus F W;
match F then nothing;
