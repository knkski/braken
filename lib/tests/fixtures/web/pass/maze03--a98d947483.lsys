let ANGLE = 90;

axiom X;

match X then F X F Y Plus F Y Plus F Y F X Minus F X Minus F X F Y Plus F Y F X Minus F X Minus F X F Y Plus;
match Y then Minus F X F Y Plus F Y Plus F Y F X Minus F X F Y Plus F Y Plus F Y F X Minus F X Minus F X F Y;
match F then nothing;
