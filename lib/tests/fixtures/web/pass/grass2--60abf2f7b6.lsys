let ANGLE = 12;

axiom Plus Plus Plus Plus Plus Plus Plus F;

match F then F [ Plus A ] F [ Minus Minus A ];
match A then Plus Color(1) F Minus ColorIncrement(3) F F F F F Plus ColorIncrement(3) F Minus ColorIncrement(3) F F F Plus ColorIncrement(3) F ColorIncrement(3) F Minus ColorIncrement(3) F F Plus ColorIncrement(3) F F F Minus ColorIncrement(3) F Plus ColorIncrement(3) F F F F F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
