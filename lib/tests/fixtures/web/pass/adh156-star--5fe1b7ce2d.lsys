# RESETIUS | ADH156_star { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  *
# RESETIUS |   Axiom \60ddd\180ddd\120ddd\180ddd\120ddd\180ddd\120ddd\180ddd\120ddd\180ddd\120ddd\180ddd\120ddd\180dd
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
#
let ANGLE = 10;

axiom ExplicitPlus(60) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D D ExplicitPlus(120) D D D ExplicitPlus(180) D D;

match D then D ExplicitPlus(80) D ExplicitMinus(160) D ExplicitPlus(80) D;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
