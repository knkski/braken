#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Pinetree {
# RESETIUS |   Angle 18
# RESETIUS |   Axiom vzfff
# RESETIUS |   v=[+++w][---w]yv
# RESETIUS |   w=+x[-w]z
# RESETIUS |   x=-w[+x]z
# RESETIUS |   y=yz
# RESETIUS |   z=[-fff][+fff]f
# RESETIUS |   }
#
let ANGLE = 20;

axiom V Z F F F;

match V then [ Plus Plus Plus W ] [ Minus Minus Minus W ] Y V;
match W then Plus X [ Minus W ] Z;
match X then Minus W [ Plus X ] Z;
match Y then Y Z;
match Z then [ Minus F F F ] [ Plus F F F ] F;
