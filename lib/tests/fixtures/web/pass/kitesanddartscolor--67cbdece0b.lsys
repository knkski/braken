# Original Fractint 20.04p17 official rule library:
# FRACTINT | KitesAndDartsColor { ; by Herb Savage
# FRACTINT | ; based on Martin Gardner's "Penrose Tiles to Trapdoor Ciphers",
# FRACTINT | ; Roger Penrose's kites and darts
# FRACTINT |   Angle 10
# FRACTINT |   Axiom WG+XG+WG+XG+WG+XG+WG+XG+WG+X
# FRACTINT |   W=[C10F][++@1.618033989C12F][++G---@.618033989G|X-Y|G|W]
# FRACTINT |   X=[C10F+++@1.618033989C12F][++@.618033989GZ|X|-G|W]
# FRACTINT |   Y=[+C10F][@1.618033989C12F][+G@.618033989|Y+X]
# FRACTINT |   Z=[-C10F][@1.618033989C12F][@.618033989G--WG|+Z]
# FRACTINT |   F=
# FRACTINT |   }
#
let ANGLE = 36;

axiom W G Plus X G Plus W G Plus X G Plus W G Plus X G Plus W G Plus X G Plus W G Plus X;

match W then [ Color(10) F ] [ Plus Plus Scale(1.618033989) Color(12) F ] [ Plus Plus G Minus Minus Minus Scale(0.618033989) G TurnAround X Minus Y TurnAround G TurnAround W ];
match X then [ Color(10) F Plus Plus Plus Scale(1.618033989) Color(12) F ] [ Plus Plus Scale(0.618033989) G Z TurnAround X TurnAround Minus G TurnAround W ];
match Y then [ Plus Color(10) F ] [ Scale(1.618033989) Color(12) F ] [ Plus G Scale(0.618033989) TurnAround Y Plus X ];
match Z then [ Minus Color(10) F ] [ Scale(1.618033989) Color(12) F ] [ Scale(0.618033989) G Minus Minus W G TurnAround Plus Z ];
match F then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
