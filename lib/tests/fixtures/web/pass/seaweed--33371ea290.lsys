#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Seaweed { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom f
# RESETIUS |   x=-<5F[+X][-X]+F>5[+X][-X]
# RESETIUS |   f=<5F[+X][-X]F>5
# RESETIUS |   }
#
let ANGLE = 24;

axiom F;

match X then Minus ColorIncrement(5) F [ Plus X ] [ Minus X ] Plus F ColorIncrement(-5) [ Plus X ] [ Minus X ];
match F then ColorIncrement(5) F [ Plus X ] [ Minus X ] F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
