let ANGLE = 24;

axiom X;

match X then ColorIncrement(1) F ColorIncrement(-1) Plus ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ] ColorIncrement(1) F ColorIncrement(-1) Minus ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ];
match F then ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ] ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
