let ANGLE = 10;

axiom Color(46) [ TurnAround Scale(0.142857142857) G Scale(7) TurnAround Plus Plus Plus Plus X ] [ Scale(0.142857142857) G Scale(7) TurnAround Minus Minus Minus Minus InvertTurns X ] Plus Plus Plus Plus Plus Plus Plus Plus Plus Scale(0.2) G Scale(5) X;

match G then G G;
match F then F [ Plus Plus Plus F X ] [ Minus Minus Minus F X ] F;
match X then ColorIncrement(-1) [ Plus Plus Plus Scale(0.666666666667) F X ] [ Minus Minus Minus Scale(0.666666666667) F X ] F X;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
