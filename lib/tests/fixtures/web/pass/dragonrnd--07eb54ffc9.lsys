let ANGLE = 45;

axiom X;

match F then nothing;
match X then F X Plus Scale(0.5) F Z Scale(2) Plus F Y;
match Y then F X Minus Scale(0.5) F Z Scale(2) Minus F Y;
match Z then F Z;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
