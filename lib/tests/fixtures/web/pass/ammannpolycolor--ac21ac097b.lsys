let ANGLE = 36;

axiom Color(1) X;

match X then Scale(0.618034) ExplicitMinus(36) [ Color(3) ExplicitPlus(9) Scale(0.66) D ] D [ Color(3) ExplicitMinus(196) Dot SourceU0035 Scale(0.363) D ] [ ExplicitMinus(180) Y ] ExplicitPlus(72) D [ ExplicitMinus(180) X ] [ ExplicitPlus(144) Scale(0.618034) M Scale(1.6180339593) X ] ExplicitPlus(108) [ Color(3) ExplicitPlus(36) Scale(0.509) D Scale(1.18) ExplicitPlus(30) D ] [ X ] D [ Color(3) ExplicitPlus(153) Scale(0.66) D ] ExplicitPlus(72) [ Y ] D;
match Y then Scale(0.618034) ExplicitMinus(72) [ X ] [ Color(3) ExplicitPlus(36) Scale(0.509) D ] D ExplicitPlus(144) [ Color(3) ExplicitPlus(9) Scale(0.66) D ] D [ ExplicitMinus(180) Y ] [ Color(3) ExplicitMinus(196) Dot SourceU0035 Scale(0.363) D ] ExplicitPlus(36) [ Y ] D ExplicitPlus(144) D [ ExplicitMinus(180) X ];
match D then M;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
