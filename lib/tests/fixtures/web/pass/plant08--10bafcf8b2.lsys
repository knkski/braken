# RESETIUS | Plant08 { ;
# RESETIUS |   Angle 10
# RESETIUS |   Axiom F
# RESETIUS |   F=F[+X]F[-Y]
# RESETIUS |   X=S-T
# RESETIUS |   Y=T+S
# RESETIUS |   S=-<2F+<2F-<2FF+<2FF-<2FFF+<2FFF-FFF>2-FFFFF>2+FFFFF>2-FFFFF>2+FFFFF>2-FFFFF>2
# RESETIUS |   T=+<2F-<2F+<2FF-<2FF+<2FFF-<2FFF+FFF>2+FFFFF>2-FFFFF>2+FFFFF>2-FFFFF>2+FFFFF>2
# RESETIUS |   }
#
let ANGLE = 36;

axiom F;

match F then F [ Plus X ] F [ Minus Y ];
match X then S Minus T;
match Y then T Plus S;
match S then Minus ColorIncrement(2) F Plus ColorIncrement(2) F Minus ColorIncrement(2) F F Plus ColorIncrement(2) F F Minus ColorIncrement(2) F F F Plus ColorIncrement(2) F F F Minus F F F ColorIncrement(-2) Minus F F F F F ColorIncrement(-2) Plus F F F F F ColorIncrement(-2) Minus F F F F F ColorIncrement(-2) Plus F F F F F ColorIncrement(-2) Minus F F F F F ColorIncrement(-2);
match T then Plus ColorIncrement(2) F Minus ColorIncrement(2) F Plus ColorIncrement(2) F F Minus ColorIncrement(2) F F Plus ColorIncrement(2) F F F Minus ColorIncrement(2) F F F Plus F F F ColorIncrement(-2) Plus F F F F F ColorIncrement(-2) Minus F F F F F ColorIncrement(-2) Plus F F F F F ColorIncrement(-2) Minus F F F F F ColorIncrement(-2) Plus F F F F F ColorIncrement(-2);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
