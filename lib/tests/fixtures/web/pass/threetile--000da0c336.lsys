let ANGLE = 30;

axiom [ Color(32) U ] Scale(1.73205080757) L;

match L then U;
match U then [ Plus Plus Plus Scale(0.57735026919) F Minus Minus Minus Minus Scale(2) F ] F X;
match X then Plus Plus Plus [ Minus Minus Minus Scale(0.57735026919) F Plus Plus Plus Plus Scale(2) F ] F Y Minus Minus Minus Minus [ Minus Scale(2) Scale(0.57735026919) F Plus Plus Plus Plus Scale(0.5) F ] F Z [ Minus Minus Minus Scale(0.57735026919) F Plus Plus Plus Plus Scale(2) F ] F Y Plus;
match Y then Minus Minus Minus [ Plus Plus Plus Scale(0.57735026919) F Minus Minus Minus Minus Scale(2) F ] F X Plus Plus Plus Plus [ Plus Scale(2) Scale(0.57735026919) F Minus Minus Minus Minus Scale(0.5) F ] F W [ Plus Plus Plus Scale(0.57735026919) F Minus Minus Minus Minus Scale(2) F ] F X Minus;
match Z then Minus [ Plus Scale(2) Scale(0.57735026919) F Minus Minus Minus Minus Scale(0.5) F ] F W [ Plus Plus Plus Scale(0.57735026919) F Minus Minus Minus Minus Scale(2) F ] F X Plus Plus Plus Plus [ Plus Scale(2) Scale(0.57735026919) F Minus Minus Minus Minus Scale(0.5) F ] F W Minus Minus Minus;
match W then Plus [ Minus Scale(2) Scale(0.57735026919) F Plus Plus Plus Plus Scale(0.5) F ] F Z [ Minus Minus Minus Scale(0.57735026919) F Plus Plus Plus Plus Scale(2) F ] F Y Minus Minus Minus Minus [ Minus Scale(2) Scale(0.57735026919) F Plus Plus Plus Plus Scale(0.5) F ] F Z Plus Plus Plus;
match F then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
