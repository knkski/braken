#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf7 {
# RESETIUS | ; order 45
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(7)][-A(7)]FA(0)
# RESETIUS |   F=@1.17F@i1.17
# RESETIUS | }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(7) ] [ Minus A(7) ] F A(0);
match F then Scale(1.17) F Scale(0.854700854701);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(7) ] [ Minus A(7) ] F A(0);
