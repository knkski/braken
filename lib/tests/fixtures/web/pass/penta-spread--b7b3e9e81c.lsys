# RESETIUS | 
# RESETIUS |     angle 10
# RESETIUS |     axiom C31++GA--G++GA--G++GA--G++GA--G++GA--G
# RESETIUS | 
# RESETIUS |     R=@0.618034>2G
# RESETIUS |     A=[+F[RZ]--F[RE]--F[RB]--F]--F
# RESETIUS |     B=+F[RB]--F--F--F--F
# RESETIUS |     Z=[+F[RY]--F[RE]--F[RB]--F]--F
# RESETIUS |     Y=[+F[RX]--F[RE]--F[RB]--F]--F
# RESETIUS |     X=[+F[RB]--F[RW]--F[RB]--F]--F
# RESETIUS |     W=[+F--F[RV]--F[RB]--F]--F
# RESETIUS |     V=[+F[RW]--F[RI]--F[RB]--F]--F
# RESETIUS |     E=[+F[RZ]--F[RH]--F[RB]--F]--F
# RESETIUS |     H=[+F[RZ]--F[RI]--F[RB]--F]--F
# RESETIUS |     I=[+F[RU]--F--F[RB]--F]--F
# RESETIUS |     U=[+F[RS]--F--F[RT]--F]--F
# RESETIUS |     S=[+F[RX]--F[RU]--F[RT]--F]--F
# RESETIUS |     T=[+F--F--F--F]--F
# RESETIUS |   }
#
let ANGLE = 36;

axiom Color(31) Plus Plus G A Minus Minus G Plus Plus G A Minus Minus G Plus Plus G A Minus Minus G Plus Plus G A Minus Minus G Plus Plus G A Minus Minus G;

match R then Scale(0.618034) ColorIncrement(-2) G;
match A then [ Plus F [ R Z ] Minus Minus F [ R E ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match B then Plus F [ R B ] Minus Minus F Minus Minus F Minus Minus F Minus Minus F;
match Z then [ Plus F [ R Y ] Minus Minus F [ R E ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match Y then [ Plus F [ R X ] Minus Minus F [ R E ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match X then [ Plus F [ R B ] Minus Minus F [ R W ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match W then [ Plus F Minus Minus F [ R V ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match V then [ Plus F [ R W ] Minus Minus F [ R I ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match E then [ Plus F [ R Z ] Minus Minus F [ R H ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match H then [ Plus F [ R Z ] Minus Minus F [ R I ] Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match I then [ Plus F [ R U ] Minus Minus F Minus Minus F [ R B ] Minus Minus F ] Minus Minus F;
match U then [ Plus F [ R S ] Minus Minus F Minus Minus F [ R T ] Minus Minus F ] Minus Minus F;
match S then [ Plus F [ R X ] Minus Minus F [ R U ] Minus Minus F [ R T ] Minus Minus F ] Minus Minus F;
match T then [ Plus F Minus Minus F Minus Minus F Minus Minus F ] Minus Minus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
