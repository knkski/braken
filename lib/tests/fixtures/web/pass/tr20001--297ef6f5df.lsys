let ANGLE = 60;

axiom Color(9) F Plus Plus Color(12) F Plus Plus Color(14) F;

match F then F Plus F TurnAround F Plus Plus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
