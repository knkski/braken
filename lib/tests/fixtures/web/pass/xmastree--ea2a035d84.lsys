#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Xmastree { ; William McWorter
# RESETIUS | ; order 10
# RESETIUS |   Angle 10
# RESETIUS |   Axiom p
# RESETIUS |   f=
# RESETIUS |   p=--<1fr++++<1fs--<1fu
# RESETIUS |   q=<1ft++<1fr----<1fs++
# RESETIUS |   r=++<1fp----<1fq++<1ft
# RESETIUS |   s=<1fu--<1fp++++<1fq--
# RESETIUS |   t=+<1fu--<1fp+
# RESETIUS |   u=-<1fq++<1ft-
# RESETIUS |   }
#
let ANGLE = 36;

axiom P;

match F then nothing;
match P then Minus Minus ColorIncrement(1) F R Plus Plus Plus Plus ColorIncrement(1) F S Minus Minus ColorIncrement(1) F U;
match Q then ColorIncrement(1) F T Plus Plus ColorIncrement(1) F R Minus Minus Minus Minus ColorIncrement(1) F S Plus Plus;
match R then Plus Plus ColorIncrement(1) F P Minus Minus Minus Minus ColorIncrement(1) F Q Plus Plus ColorIncrement(1) F T;
match S then ColorIncrement(1) F U Minus Minus ColorIncrement(1) F P Plus Plus Plus Plus ColorIncrement(1) F Q Minus Minus;
match T then Plus ColorIncrement(1) F U Minus Minus ColorIncrement(1) F P Plus;
match U then Minus ColorIncrement(1) F Q Plus Plus ColorIncrement(1) F T Minus;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
