let ANGLE = 15.652173913;

axiom X;

match X then Plus ColorIncrement(5) F [ Minus Minus X ] Minus Minus F ColorIncrement(-5) [ Minus X ];
match F then Minus ColorIncrement(5) F [ Minus Minus F ] Plus F ColorIncrement(-5) [ Minus F ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
