# RESETIUS | Sapin2 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom X
# RESETIUS |   X=>5F[+X][-X]>5F[+X][-X]>5F[+X][-X]>5F<5[+X][-X]F<5[+X][-X]F<5[X]
# RESETIUS |   F=f@0.9975f@0.9935F
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then ColorIncrement(-5) F [ Plus X ] [ Minus X ] ColorIncrement(-5) F [ Plus X ] [ Minus X ] ColorIncrement(-5) F [ Plus X ] [ Minus X ] ColorIncrement(-5) F ColorIncrement(5) [ Plus X ] [ Minus X ] F ColorIncrement(5) [ Plus X ] [ Minus X ] F ColorIncrement(5) [ X ];
match F then F Scale(0.9975) F Scale(0.9935) F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
