let ANGLE = 45;

axiom Color(88) F X;

match F then nothing;
match X then Plus F Y Minus ColorIncrement(1) Minus Scale(2) F Scale(0.5) X Plus ColorIncrement(-1) Plus F Y Minus;
match Y then Scale(1.41421356237) F Scale(0.5) X Scale(1.41421356237);
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
