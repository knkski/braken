let ANGLE = 30;

axiom Color(19) Plus F Plus Plus Plus F Plus Plus Plus F Plus Plus Plus F Plus Plus Plus Plus Plus Plus F Minus Minus Minus F Minus Minus Minus F Minus Minus Minus F;

match F then F [ ColorIncrement(2) Plus Plus Plus Plus F Minus Minus Minus Minus F Minus Minus Minus Minus F ] F F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
