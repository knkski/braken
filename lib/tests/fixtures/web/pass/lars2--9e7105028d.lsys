# Original Fractint 20.04p17 official rule library:
# FRACTINT | Lars2{ ; By Jonathan Osuch [73277,1432]
# FRACTINT |        ; Based on a suggestion by Lars Vangsgaard
# FRACTINT |   Angle 8  ; angle increment/decrement is 45
# FRACTINT |   axiom +[F]++[F]++[F]++F
# FRACTINT |   F=F[+F][-F]
# FRACTINT |   }
#
let ANGLE = 45;

axiom Plus [ F ] Plus Plus [ F ] Plus Plus [ F ] Plus Plus F;

match F then F [ Plus F ] [ Minus F ];
