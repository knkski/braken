#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH156_x { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  x
# RESETIUS |   Axiom \45ddd\90ddd\180ddd\90ddd\180ddd\90ddd\180ddd\90ddd\180ddd
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
#
let ANGLE = 10;

axiom ExplicitPlus(45) D D D ExplicitPlus(90) D D D ExplicitPlus(180) D D D ExplicitPlus(90) D D D ExplicitPlus(180) D D D ExplicitPlus(90) D D D ExplicitPlus(180) D D D ExplicitPlus(90) D D D ExplicitPlus(180) D D D;

match D then D ExplicitPlus(80) D ExplicitMinus(160) D ExplicitPlus(80) D;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
