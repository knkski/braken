# RESETIUS | Seaweed08 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom xy
# RESETIUS |   x=<1+F>1+<1F>1[+y][-y]<1F>1-<1F>1[+y][-y]
# RESETIUS |   y=<1-F>1-<1F>1[+x][-x]<1F>1+<1F>1[+x][-x]
# RESETIUS |   f=<10F[+x][-x][+y][-y]F>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom X Y;

match X then ColorIncrement(1) Plus F ColorIncrement(-1) Plus ColorIncrement(1) F ColorIncrement(-1) [ Plus Y ] [ Minus Y ] ColorIncrement(1) F ColorIncrement(-1) Minus ColorIncrement(1) F ColorIncrement(-1) [ Plus Y ] [ Minus Y ];
match Y then ColorIncrement(1) Minus F ColorIncrement(-1) Minus ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ] ColorIncrement(1) F ColorIncrement(-1) Plus ColorIncrement(1) F ColorIncrement(-1) [ Plus X ] [ Minus X ];
match F then ColorIncrement(10) F [ Plus X ] [ Minus X ] [ Plus Y ] [ Minus Y ] F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
