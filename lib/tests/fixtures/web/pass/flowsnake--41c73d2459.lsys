# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | FlowSnake { ; Adrian Mariano
# RESETIUS | ; from The Fractal Geometry of Nature by Mandelbrot
# RESETIUS |   angle 6
# RESETIUS |   axiom FL
# RESETIUS |   L=FL-FR--FR+FL++FLFL+FR-"
# RESETIUS |   R=+FL-FRFR--FR-FL++FL+FR"
# RESETIUS |   F=
# RESETIUS |   }
#
# Original Fractint 20.04p17 official rule library:
# FRACTINT | FlowSnake { ; Adrian Mariano
# FRACTINT | ; from The Fractal Geometry of Nature by Mandelbrot
# FRACTINT |   angle=6;
# FRACTINT |   axiom FL
# FRACTINT |   L=FL-FR--FR+FL++FLFL+FR-",
# FRACTINT |   R=+FL-FRFR--FR-FL++FL+FR",
# FRACTINT |   F=
# FRACTINT |   }
#
let ANGLE = 60;

axiom F L;

match L then F L Minus F R Minus Minus F R Plus F L Plus Plus F L F L Plus F R Minus;
match R then Plus F L Minus F R F R Minus Minus F R Minus F L Plus Plus F L Plus F R;
match F then nothing;
