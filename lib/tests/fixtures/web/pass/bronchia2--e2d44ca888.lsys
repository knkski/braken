let ANGLE = 12;

axiom X;

match F then Minus ColorIncrement(1) F ColorIncrement(-1) [ Minus X ] Plus ColorIncrement(1) F ColorIncrement(-1) [ Plus X ];
match X then [ Plus F ] Minus ColorIncrement(1) F ColorIncrement(-1) [ Plus F ] Minus ColorIncrement(1) F ColorIncrement(-1);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
