# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1bd_2 { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom +++x
# RESETIUS |   X=<3F<4F[s][t]<5F[s][t]F>5[s][t]F>4[s][t]F>3[s][t]
# RESETIUS |   s=+<3F+<4F[+s][-t]+<5F[+s][-t]
# RESETIUS |   s=+F>5[+s][-t]-F>4[+s][-t]-F>3[+s][-t]
# RESETIUS |   t=-<3F-<4F[+s][-t]-<5F[+s][-t]
# RESETIUS |   t=-F>5[+s][-t]+F>4[+s][-t]+F>3[+s][-t]
# RESETIUS |   F=<10F<10F>10@.9985F>10
# RESETIUS |   }
#
let ANGLE = 12;

axiom Plus Plus Plus X;

match X then ColorIncrement(3) F ColorIncrement(4) F [ S ] [ T ] ColorIncrement(5) F [ S ] [ T ] F ColorIncrement(-5) [ S ] [ T ] F ColorIncrement(-4) [ S ] [ T ] F ColorIncrement(-3) [ S ] [ T ];
match S then Plus ColorIncrement(3) F Plus ColorIncrement(4) F [ Plus S ] [ Minus T ] Plus ColorIncrement(5) F [ Plus S ] [ Minus T ] Plus F ColorIncrement(-5) [ Plus S ] [ Minus T ] Minus F ColorIncrement(-4) [ Plus S ] [ Minus T ] Minus F ColorIncrement(-3) [ Plus S ] [ Minus T ];
match T then Minus ColorIncrement(3) F Minus ColorIncrement(4) F [ Plus S ] [ Minus T ] Minus ColorIncrement(5) F [ Plus S ] [ Minus T ] Minus F ColorIncrement(-5) [ Plus S ] [ Minus T ] Plus F ColorIncrement(-4) [ Plus S ] [ Minus T ] Plus F ColorIncrement(-3) [ Plus S ] [ Minus T ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) Scale(0.9985) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
