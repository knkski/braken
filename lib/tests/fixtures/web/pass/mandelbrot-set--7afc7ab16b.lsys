let ANGLE = 22.5;

axiom Color(25) Plus Plus Plus F [ Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus Plus Plus F [ Minus Minus Minus Minus Scale(0.25) X ] Plus Plus F [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus F [ Minus Minus Minus Minus Scale(0.707106781187) A ] Plus Plus F [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus F [ Minus Minus Minus Minus Scale(0.25) X ] Plus Plus F [ Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus Plus Plus F;

match A then ColorIncrement(1) Minus Minus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus Scale(0.333333333333) X ] Plus Plus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus Scale(0.57735026919) A ] Plus Plus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus Scale(0.333333333333) X ] Plus Plus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E ColorIncrement(-1);
match B then ColorIncrement(1) [ Scale(0.833333333333) Z ] Minus Minus E [ Plus Plus Plus Plus Scale(0.833333333333) Z ] [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus Scale(0.707106781187) Z ] [ Plus Plus Plus Plus Scale(0.707106781187) Z ] Plus Plus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus A ] Plus Plus E [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E [ Minus Minus Minus Minus Scale(0.707106781187) Z ] [ Plus Plus Plus Plus Scale(0.707106781187) Z ] Plus Plus E [ Plus Plus Plus Plus Scale(0.833333333333) Z ] [ Minus Minus Minus Minus Scale(0.166666666667) Y ] Plus Plus E ColorIncrement(-1);
match E then Scale(2) F Scale(0.5);
match F then F [ Minus Minus Minus Minus Minus Scale(0.285714285714) B ] F;
match X then Scale(2) A Scale(0.5);
match Y then Scale(2) X Scale(0.5);
match Z then Scale(2) B Scale(0.5);
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
