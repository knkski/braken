# RESETIUS | Sierp.Trigon.1 {
# RESETIUS | 
# RESETIUS |   ; best order 6 and 9
# RESETIUS |   ; time 0:01 and 0:06
# RESETIUS | 
# RESETIUS |     angle 6
# RESETIUS |     axiom C32FX-FY-FX-FY-FX-FY-
# RESETIUS | 
# RESETIUS |     F=
# RESETIUS |     X=-FY+<2FX>2+FY-
# RESETIUS |     Y=+FX-<2FY>2-FX+
# RESETIUS |   }
#
let ANGLE = 60;

axiom Color(32) F X Minus F Y Minus F X Minus F Y Minus F X Minus F Y Minus;

match F then nothing;
match X then Minus F Y Plus ColorIncrement(2) F X ColorIncrement(-2) Plus F Y Minus;
match Y then Plus F X Minus ColorIncrement(2) F Y ColorIncrement(-2) Minus F X Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
