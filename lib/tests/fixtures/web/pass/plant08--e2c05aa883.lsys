#
# Original Fractint 20.04p17 official rule library:
# FRACTINT | Plant08 { ; Ken Philip, from The Science of Fractal Images, p.286
# FRACTINT |   axiom SLFFF
# FRACTINT |   s=[+++Z][---Z]TS
# FRACTINT |   z=+H[-Z]L
# FRACTINT |   h=-Z[+H]L
# FRACTINT |   t=TL
# FRACTINT |   l=[-FFF][+FFF]F
# FRACTINT |   angle 20
# FRACTINT |   }
#
let ANGLE = 18;

axiom S L F F F;

match S then [ Plus Plus Plus Z ] [ Minus Minus Minus Z ] T S;
match Z then Plus H [ Minus Z ] L;
match H then Minus Z [ Plus H ] L;
match T then T L;
match L then [ Minus F F F ] [ Plus F F F ] F;
