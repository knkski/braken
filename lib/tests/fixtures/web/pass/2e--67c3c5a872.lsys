#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 2e { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom x
# RESETIUS |   x=<5F[++Y][--Y]<5@.9326F[++Y][--Y]<5@.8557F[++Y][--Y]
# RESETIUS |   x=@.7788F>5[++Y][--Y]@.7019F>5[+Y][-Y]@.625F>5[Y]
# RESETIUS |   y=<5F[++X][--X]<5@.9326F[++X][--X]<5@.8557F[++X][--X]
# RESETIUS |   y=@.7788F>5[++X][--X]@.7019F>5[+X][-X]@.625F>5[X]
# RESETIUS |   F=<10F<10F>10F>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then ColorIncrement(5) F [ Plus Plus Y ] [ Minus Minus Y ] ColorIncrement(5) Scale(0.9326) F [ Plus Plus Y ] [ Minus Minus Y ] ColorIncrement(5) Scale(0.8557) F [ Plus Plus Y ] [ Minus Minus Y ] Scale(0.7788) F ColorIncrement(-5) [ Plus Plus Y ] [ Minus Minus Y ] Scale(0.7019) F ColorIncrement(-5) [ Plus Y ] [ Minus Y ] Scale(0.625) F ColorIncrement(-5) [ Y ];
match Y then ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus X ] ColorIncrement(5) Scale(0.9326) F [ Plus Plus X ] [ Minus Minus X ] ColorIncrement(5) Scale(0.8557) F [ Plus Plus X ] [ Minus Minus X ] Scale(0.7788) F ColorIncrement(-5) [ Plus Plus X ] [ Minus Minus X ] Scale(0.7019) F ColorIncrement(-5) [ Plus X ] [ Minus X ] Scale(0.625) F ColorIncrement(-5) [ X ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
