let SCALE = 0.707106781;

axiom F Plus Plus F Plus Plus F Plus Plus A;

match A then [ Minus Minus Minus ScaleLength F Plus Plus A Plus Plus F Plus Plus F ] F [ Minus Minus Minus ScaleLength F Plus Plus F Plus Plus A Plus Plus F ];
