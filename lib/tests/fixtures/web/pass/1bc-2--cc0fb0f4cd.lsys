let ANGLE = 24;

axiom X;

match X then ColorIncrement(5) F ColorIncrement(5) F F [ S ] [ T ] ColorIncrement(5) F F [ S ] [ T ] F F ColorIncrement(-5) [ S ] [ T ] Scale(0.9985) F F ColorIncrement(-5) [ S ] [ T ] Scale(0.9945) F F ColorIncrement(-5) [ S ] [ T ];
match S then Plus ColorIncrement(3) F Plus ColorIncrement(4) F [ Plus S ] [ Minus T ] Plus ColorIncrement(5) F [ Plus S ] [ Minus T ] Plus F [ Plus S ] [ Minus T ] Minus F ColorIncrement(-5) [ Plus S ] [ Minus T ] Minus F ColorIncrement(-4) [ Plus S ] [ Minus T ] Minus F ColorIncrement(-3) [ Plus S ] [ Minus T ];
match T then Minus ColorIncrement(3) F Minus ColorIncrement(4) F [ Plus S ] [ Minus T ] Minus ColorIncrement(5) F [ Plus S ] [ Minus T ] Minus F [ Plus S ] [ Minus T ] Plus F ColorIncrement(-5) [ Plus S ] [ Minus T ] Plus F ColorIncrement(-4) [ Plus S ] [ Minus T ] Plus F ColorIncrement(-3) [ Plus S ] [ Minus T ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) Scale(0.9985) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
