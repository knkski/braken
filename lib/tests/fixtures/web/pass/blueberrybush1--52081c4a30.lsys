let ANGLE = 11.25;

axiom TurtleNumber9 a;

match a then TurtleNumber4 RollRight [ PitchUp PitchUp l ];
match l then [ X PitchUp [ Plus Plus B ] r ];
match r then TurtleNumber4 X PitchUp [ Minus Minus B ] l;
match B then [ b [ TurtleNumber3 Plus L ] [ TurtleNumber3 Minus L ] X B ];
match L then F ColorPrevious PolygonBegin Plus Y Vertex Minus Y Vertex Minus Y Vertex Plus TurnAround Plus Y Vertex Minus Y Vertex PolygonEnd;
match X then F X;
match Y then g Y;
match z then TurtleNumber4 RollRight [ PitchUp B ];
match b then X TurtleNumber8 ColorPrevious [ PitchUp PitchUp TurtleNumber4 F Surface S ] TurtleNumber8 ColorNext;
