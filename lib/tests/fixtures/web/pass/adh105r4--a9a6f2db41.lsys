#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH105r4 { ; rounded version of Anthony Hanmer's 105d, 2000
# RESETIUS |   Angle 8 ; playing
# RESETIUS |   Axiom x
# RESETIUS |   f=
# RESETIUS |   y=fy
# RESETIUS |   x=fx+@.5fy@2+gx+@.5gy@2+fx-@.5fy@2-gx-@.5gy@2-fx
# RESETIUS |   }
#
let ANGLE = 45;

axiom X;

match F then nothing;
match Y then F Y;
match X then F X Plus Scale(0.5) F Y Scale(2) Plus G X Plus Scale(0.5) G Y Scale(2) Plus F X Minus Scale(0.5) F Y Scale(2) Minus G X Minus Scale(0.5) G Y Scale(2) Minus F X;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
