#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf6 {
# RESETIUS | ; order 30
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(4)][-A(4)]FA(0)
# RESETIUS |   F=@1.23F@i1.23
# RESETIUS | }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(4) ] [ Minus A(4) ] F A(0);
match F then Scale(1.23) F Scale(0.813008130081);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(4) ] [ Minus A(4) ] F A(0);
