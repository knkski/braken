let ANGLE = 36;

axiom X;

match X then Scale(0.618034) ExplicitMinus(36) [ ExplicitPlus(9) Scale(0.66) D ] M [ ExplicitMinus(196) Dot SourceU0035 Scale(0.363) D ] [ ExplicitMinus(180) Y ] ExplicitPlus(72) M [ ExplicitMinus(180) X ] [ ExplicitPlus(144) Scale(0.618034) M Scale(1.6180339593) X ] ExplicitPlus(108) [ ExplicitPlus(36) Scale(0.509) D Scale(1.18) ExplicitPlus(30) D ] [ X ] M [ ExplicitPlus(153) Scale(0.66) D ] ExplicitPlus(72) [ Y ] M;
match Y then Scale(0.618034) ExplicitMinus(72) [ X ] [ ExplicitPlus(36) Scale(0.509) D ] M ExplicitPlus(144) [ ExplicitPlus(9) Scale(0.66) D ] M [ ExplicitMinus(180) Y ] [ ExplicitMinus(196) Dot SourceU0035 Scale(0.363) D ] ExplicitPlus(36) [ Y ] M ExplicitPlus(144) M [ ExplicitMinus(180) X ];
match D then M;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
