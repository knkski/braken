#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Symmetry { ;
# RESETIUS |   Angle 4
# RESETIUS |   Axiom X
# RESETIUS |   X=+<10F[--X]-F>10[++X]+<10F[--X]-F>10[++X]
# RESETIUS |   F=<1FF>1
# RESETIUS |   }
#
let ANGLE = 90;

axiom X;

match X then Plus ColorIncrement(10) F [ Minus Minus X ] Minus F ColorIncrement(-10) [ Plus Plus X ] Plus ColorIncrement(10) F [ Minus Minus X ] Minus F ColorIncrement(-10) [ Plus Plus X ];
match F then ColorIncrement(1) F F ColorIncrement(-1);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
