# Formalism: Fractint-style context-free turtle string
# Parse    : pass; validator=corpus-static
# Execute  : pass; engine=bounded-python-context-free; iterations=4
# Render   : pass; file=../renders/adh156-7--6fe63433ec.svg
# Fidelity : equivalent
# Features : context-free, delayed-expansion, deterministic, fractint-turtle, parametric
# Angle    : 10
# Heading  : 0
# Draw     : F D
# Move     : G M
# Profile  : turtle2d-fractint
# Fingerprint: sha256:6fe63433ecc9e0359c76df20e6c76c13b122fe7150cfedfb320e28433fb4fc25
#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH156_7 { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  7
# RESETIUS |   Axiom dd/100ddddd
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
#
let ANGLE = 10;

axiom D D ExplicitMinus(100) D D D D D;

match D then D ExplicitPlus(80) D ExplicitMinus(160) D ExplicitPlus(80) D;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
