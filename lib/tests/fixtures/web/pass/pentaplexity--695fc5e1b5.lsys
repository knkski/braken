# RESETIUS | PentaPlexity-0 {
# RESETIUS | ; Manual construction by Roger Penrose as a prelude to his development of
# RESETIUS | ; the famous Penrose tiles (the kites and darts) that tile the plane
# RESETIUS | ; only non-periodically.
# RESETIUS | ; Translated first to a "dragon curve" and finally to an L-system
# RESETIUS | ; by Joe Saverino.
# RESETIUS |   Angle 10
# RESETIUS |   Axiom F++F++F++F++F
# RESETIUS |   F=F++F++F|F-F++F
# RESETIUS |   }
#
# Original Fractint 20.04p17 official rule library:
# FRACTINT | PentaPlexity {
# FRACTINT | ; Manual construction by Roger Penrose as a prelude to his development of
# FRACTINT | ; the famous Penrose tiles (the kites and darts) that tile the plane
# FRACTINT | ; only non-periodically.
# FRACTINT | ; Translated first to a "dragon curve" and finally to an L-system
# FRACTINT | ; by Joe Saverino.
# FRACTINT |   Angle 10
# FRACTINT |   Axiom F++F++F++F++F
# FRACTINT |   F=F++F++F|F-F++F
# FRACTINT |   }
#
# Original Elm L-System Studio presets (BSD-3-Clause, commit a40179d):
# ELM | pentaplexity =
# ELM |     { default
# ELM |         | rules =
# ELM |             [ ( 'F', "F++F++F|F-F++F" )
# ELM |             ]
# ELM |         , axiom = "F++F++F++F++F"
# ELM |         , iterations = 4
# ELM |         , lineLength = 1
# ELM |         , turningAngle = Angle.fromDegrees 36
# ELM |         , windowPosition = { x = -15, y = -3 }
# ELM |         , windowSize = 77
# ELM |     }
#
# Original Paul Bourke L-system manual/catalog:
# BOURKE | axiom = F++F++F++F++F
# BOURKE | F -> F++F++F|F-F++F
# BOURKE | angle = 36
#
let ANGLE = 36;

axiom F Plus Plus F Plus Plus F Plus Plus F Plus Plus F;

match F then F Plus Plus F Plus Plus F TurnAround F Minus F Plus Plus F;
