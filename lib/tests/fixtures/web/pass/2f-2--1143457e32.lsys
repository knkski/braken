# RESETIUS |   x=@.7619F>5[s][t]@.725F>5[s][t]
# RESETIUS |   t=+<1F[++s][t]+<3@.9326F[++s][t]+<5@.7788F[++s][t]
# RESETIUS |   t=-@.7619F>5[++s][t]-@.725F>3[+s][t]-@.7019F>1[t]
