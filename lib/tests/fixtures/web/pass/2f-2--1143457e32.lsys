let ANGLE = 12;

axiom X;

match X then ColorIncrement(5) Scale(0.9326) F [ S ] [ T ] ColorIncrement(5) Scale(0.8557) F [ S ] [ T ] ColorIncrement(5) Scale(0.7788) F ColorIncrement(-5) [ S ] [ T ] Scale(0.7619) F ColorIncrement(-5) [ S ] [ T ] Scale(0.725) F ColorIncrement(-5) [ S ] [ T ];
match T then Plus ColorIncrement(1) F [ Plus Plus S ] [ T ] Plus ColorIncrement(3) Scale(0.9326) F [ Plus Plus S ] [ T ] Plus ColorIncrement(5) Scale(0.7788) F [ Plus Plus S ] [ T ] Minus Scale(0.7619) F ColorIncrement(-5) [ Plus Plus S ] [ T ] Minus Scale(0.725) F ColorIncrement(-3) [ Plus S ] [ T ] Minus Scale(0.7019) F ColorIncrement(-1) [ T ];
match S then Minus ColorIncrement(1) F [ S ] [ Minus Minus T ] Minus ColorIncrement(3) Scale(0.9326) F [ S ] [ Minus Minus T ] Minus ColorIncrement(5) Scale(0.7788) F [ S ] [ Minus Minus T ] Plus Scale(0.7619) F ColorIncrement(-5) [ S ] [ Minus Minus T ] Plus Scale(0.725) F ColorIncrement(-3) [ S ] [ Minus T ] Plus Scale(0.7019) F ColorIncrement(-1) [ S ];
match F then ColorIncrement(8) F F F ColorIncrement(-8);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
