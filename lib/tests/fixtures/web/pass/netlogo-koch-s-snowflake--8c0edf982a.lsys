# Note     : NetLogo runs one procedure per live turtle per tick. Tip parameters preserve turtle-local length, and [Tip(...)] represents a spawned clone at its spawn pose.
# Note     : Geometry is preserved; NetLogo color inheritance/increment and absolute initial x/y translation are omitted because the target language has no equivalent state channels.
# Note     : NetLogo heading 0 (north) is normalized to Cartesian turtle heading 90 degrees.
# Note     : The model leaves tick count interactive; no source iteration count is asserted.
# Note     : Official model page: https://ccl.northwestern.edu/netlogo/models/L-SystemFractals
# Note     : Source initial point: (-47, -82); source initial heading: 0 degrees.
#
# Original NetLogo L-System Fractals model:
# NETLOGO-LSYSTEM-FR | to setup-koch
# NETLOGO-LSYSTEM-FR |   set color-inc 5
# NETLOGO-LSYSTEM-FR |   set init-color 9
# NETLOGO-LSYSTEM-FR |   set init-x -47
# NETLOGO-LSYSTEM-FR |   set init-y -82
# NETLOGO-LSYSTEM-FR |   setup
# NETLOGO-LSYSTEM-FR |   ask turtles [ set len 160 ]
# NETLOGO-LSYSTEM-FR |   set rule-set "koch"
# NETLOGO-LSYSTEM-FR | end
# NETLOGO-LSYSTEM-FR | 
# NETLOGO-LSYSTEM-FR | to koch
# NETLOGO-LSYSTEM-FR |   set len len / 3
# NETLOGO-LSYSTEM-FR |   ifelse ticks = 0
# NETLOGO-LSYSTEM-FR |   [ repeat 3 [ spawn fd len lt 60 spawn fd len rt 120 spawn fd len lt 60 spawn fd len rt 120 ] ]
# NETLOGO-LSYSTEM-FR |   [ spawn fd len lt 60 spawn fd len rt 120 spawn fd len lt 60 spawn fd len rt 120 ]
# NETLOGO-LSYSTEM-FR |   die
# NETLOGO-LSYSTEM-FR | end
#
axiom Seed(160);

match Seed(len) then [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120);
match Tip(len) then [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120) [ Tip(len / 3) ] Forward(len / 3) ExplicitPlus(60) [ Tip(len / 3) ] Forward(len / 3) ExplicitMinus(120);
