let ANGLE = 36;

axiom [ A ] Plus Plus [ A ] Plus Plus [ A ] Plus Plus [ A ] Plus Plus [ A ];

match K then Plus [ Scale(0.618034) A ] F Scale(0.618034) Minus Minus Minus [ Minus K ] F Minus F Minus Minus Minus [ Minus K ] Scale(1.6180339593) F [ Scale(0.618034) TurnAround A ];
match A then [ Scale(0.618034) K ] Plus F Scale(0.618034) [ TurnAround A ] Minus Minus Minus Minus F Plus F Minus Minus Minus Minus [ A ] Scale(1.6180339593) F;
match F then G;
