# RESETIUS | ADH156_kavichka_1 { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  " (opening, 66)
# RESETIUS |   ;Axiom /90dd/60d
# RESETIUS |   Axiom \240dd\30d\90c000dd\90c015d/30dd
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
#
let ANGLE = 10;

axiom ExplicitPlus(240) D D ExplicitPlus(30) D ExplicitPlus(90) Color(0) D D ExplicitPlus(90) Color(15) D ExplicitMinus(30) D D;

match D then D ExplicitPlus(80) D ExplicitMinus(160) D ExplicitPlus(80) D;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
