let ANGLE = 36;

axiom Color(40) Plus [ J ] F X Plus Plus [ J ] F X Plus Plus [ J ] F X Plus Plus [ J ] F X Plus Plus [ J ] F X Plus Plus;

match A then ColorIncrement(1) Plus G [ Scale(0.236068) Minus I ] Plus Plus Scale(0.381966) E;
match B then [ A ] F X [ Scale(0.618034) Minus H ] Plus Plus [ A ] F X [ Scale(0.618034) Minus G Plus Plus G Plus Plus H ] Plus Plus [ A ] F X [ Scale(0.618034) Minus H ] Plus Plus [ A ] F X Plus Plus [ A ] F X;
match L then [ A ] F X [ Scale(0.618034) Minus H ] Plus Plus [ A ] F X Plus Plus [ A ] F X [ Scale(0.618034) Minus H ] Plus Plus [ A ] F X Plus Plus [ A ] F X;
match H then [ A ] F X [ Scale(0.618034) Minus H ] Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X;
match J then Plus G [ Scale(0.236068) Minus K ] Plus Plus Scale(0.381966) E;
match E then A;
match I then B;
match K then L;
match F then nothing;
match X then F Y;
match Y then F W;
match W then G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
