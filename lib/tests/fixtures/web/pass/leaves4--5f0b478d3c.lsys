let ANGLE = 12;

axiom X;

match X then F [ Plus Plus Plus Plus S ] [ Minus Minus Minus Minus T ] Scale(0.9326) F [ Plus Plus Plus S ] [ Minus Minus Minus T ] Scale(0.8557) F [ Plus Plus S ] [ Minus Minus T ] Scale(0.7788) F [ Plus S ] [ Minus T ];
match S then Plus ColorIncrement(5) F [ Plus Plus S ] [ Minus Minus Minus S ] Minus ColorIncrement(5) F [ Plus Plus S ] [ Minus Minus Minus S ] Minus ColorIncrement(5) Scale(0.9326) F [ Plus Plus S ] [ Minus Minus Minus S ] Minus Scale(0.8557) F ColorIncrement(-5) [ Plus Plus S ] [ Minus Minus Minus S ] Minus Scale(0.7788) F ColorIncrement(-5) [ Plus S ] [ Minus Minus S ] Minus Scale(0.7019) F ColorIncrement(-5) [ S ] [ Minus S ];
match T then Minus ColorIncrement(5) F [ Plus Plus Plus T ] [ Minus Minus T ] Plus ColorIncrement(5) F [ Plus Plus Plus T ] [ Minus Minus T ] Plus ColorIncrement(5) Scale(0.9326) F [ Plus Plus Plus T ] [ Minus Minus T ] Plus Scale(0.8557) F ColorIncrement(-5) [ Plus Plus Plus T ] [ Minus Minus T ] Plus Scale(0.7788) F ColorIncrement(-5) [ Plus Plus T ] [ Minus T ] Plus Scale(0.7019) F ColorIncrement(-5) [ Plus T ] [ T ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
