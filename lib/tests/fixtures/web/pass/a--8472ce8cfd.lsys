# RESETIUS |   x=g-g--c40f+fc15f-ff+fc56f-fc15++g+gx++g-g--c40f+fc15f-ff+fc56f-fc15++g+gx--g-g--c40f+fc15f-ff+fc56f-fc15++g+gx
# RESETIUS |   f=
