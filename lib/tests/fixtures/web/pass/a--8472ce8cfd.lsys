let ANGLE = 60;

axiom R;

match R then G Minus G Minus Minus Color(40) F Plus F Color(15) F Minus F F Plus F Color(56) F Minus F Color(15) Plus Plus G Plus G X;
match X then G Minus G Minus Minus Color(40) F Plus F Color(15) F Minus F F Plus F Color(56) F Minus F Color(15) Plus Plus G Plus G X Plus Plus G Minus G Minus Minus Color(40) F Plus F Color(15) F Minus F F Plus F Color(56) F Minus F Color(15) Plus Plus G Plus G X Minus Minus G Minus G Minus Minus Color(40) F Plus F Color(15) F Minus F F Plus F Color(56) F Minus F Color(15) Plus Plus G Plus G X;
match F then nothing;
match G then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
