let ANGLE = 22.5;

axiom X;

match F then F F;
match X weight 1 then F Minus [ [ X ] Plus X ] Plus F [ Plus F X ] Minus X;
match X weight 1 then F Plus [ [ X ] Minus X ] Minus F [ Minus F X ] Plus X;
