#
# Original Fractint 20.04p17 official rule library:
# FRACTINT | Island1 { ; Adrian Mariano
# FRACTINT | ; from The Fractal Geometry of Nature by Mandelbrot
# FRACTINT |   angle 4
# FRACTINT |   axiom F+F+F+F
# FRACTINT |   F=FFFF-F+F+F-F[-GFF+F+FF+F]FF
# FRACTINT |   G=@8G@I8
# FRACTINT |   }
#
let ANGLE = 90;

axiom F Plus F Plus F Plus F;

match F then F F F F Minus F Plus F Plus F Minus F [ Minus G F F Plus F Plus F F Plus F ] F F;
match G then Scale(8) G Scale(0.125);
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
