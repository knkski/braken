let ANGLE = 30;

axiom R;

match R then S;
match S then Plus Plus Plus Color(40) F W Minus Minus Color(15) F P Minus Minus Color(48) F Z Color(15) F P Color(56) F W Plus;
match Y then Plus Plus Plus F W Minus Minus F P Minus Minus F Z F P F W Plus;
match X then Plus F Z F P F W Minus Minus F P Minus Minus F Z Plus Plus Plus;
match W then Minus Minus Minus F Y Plus Plus F P Plus Plus F X F P F Y Minus;
match Z then Minus F X F P F Y Plus Plus F P Plus Plus F X Minus Minus Minus;
match P then F P;
match F then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
