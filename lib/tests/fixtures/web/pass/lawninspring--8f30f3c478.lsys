let ANGLE = 22.5;

axiom Color(49) X;

match X then [ Plus Plus Plus Plus Plus F Minus F Minus F Z ] G X Plus Plus Plus Plus G Y;
match Y then [ Plus Plus Plus Plus Plus F Minus F Minus F Z ] G X Minus Minus Minus Minus G Y;
match Z then W;
match W then U;
match U then [ Color(44) Scale(0.3) [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G Plus Plus [ Plus Plus Plus F ] G ] Z;
match F then nothing;
match G then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
