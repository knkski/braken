# RESETIUS | Strike_S { ; William McWorter
# RESETIUS |   ; Strikethrough S
# RESETIUS |   Angle 4
# RESETIUS |   Axiom UW
# RESETIUS |   F=
# RESETIUS |   U=FU+F-V
# RESETIUS |   V=++F--W++F--Z
# RESETIUS |   W=++F--W-F+X
# RESETIUS |   X=FUFY
# RESETIUS |   Y=+F-VFY
# RESETIUS |   Z=-F+X--F++Z
# RESETIUS |   }
#
let ANGLE = 90;

axiom U W;

match F then nothing;
match U then F U Plus F Minus V;
match V then Plus Plus F Minus Minus W Plus Plus F Minus Minus Z;
match W then Plus Plus F Minus Minus W Minus F Plus X;
match X then F U F Y;
match Y then Plus F Minus V F Y;
match Z then Minus F Plus X Minus Minus F Plus Plus Z;
