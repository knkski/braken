# Original propfeds L-systems Renderer manual/gallery:
# SCHOLARLY | new LSystem('AK', [
# SCHOLARLY |             'A=[--//K][++//K]I///A',
# SCHOLARLY |             'I=Fi',
# SCHOLARLY |             'i=Fj',
# SCHOLARLY |             'j=J[--FFA][++FFA]',
# SCHOLARLY |             '~K=F[+++[--F+F]^^^[--F+F]^^^[--F+F]^^^[--F+F]]'
# SCHOLARLY |         ], 30)
#
let ANGLE = 30;

axiom A K;

match A then [ Minus Minus RollRight RollRight K ] [ Plus Plus RollRight RollRight K ] I RollRight RollRight RollRight A;
match I then F i;
match i then F j;
match j then J [ Minus Minus F F A ] [ Plus Plus F F A ];
