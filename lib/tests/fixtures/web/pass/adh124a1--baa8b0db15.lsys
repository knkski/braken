# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH124a1 { ; Anthony Hanmer 2000
# RESETIUS | ; order 4
# RESETIUS |   Angle 4 ; Odd orders cancel to a blank screen -
# RESETIUS |   Axiom f-f-f-f ; only even orders show...
# RESETIUS |   f=h-h+g+h-h
# RESETIUS |   h=f+f-g-f+f
# RESETIUS |   }
#
let ANGLE = 90;

axiom F Minus F Minus F Minus F;

match F then H Minus H Plus G Plus H Minus H;
match H then F Plus F Minus G Minus F Plus F;
