let ANGLE = 36;

axiom X;

match F then nothing;
match G then nothing;
match X then Plus Plus F Z Minus Minus Minus Minus F Y Plus Plus F X;
match Y then Plus F W Minus Minus G Z Plus;
match Z then Minus Minus F X Plus Plus Plus Plus F W Minus Minus F Z;
match W then Minus F Y Plus Plus G X Minus;
