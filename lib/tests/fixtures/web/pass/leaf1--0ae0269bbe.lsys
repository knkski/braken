#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf1 {
# RESETIUS | ; order 20
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(1)]Fb
# RESETIUS |   b=F[-B(1)]Fa
# RESETIUS |   F=@1.36F@i1.36
# RESETIUS |   }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(1) ] F B;
match B then F [ Minus B(1) ] F A;
match F then Scale(1.36) F Scale(0.735294117647);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(1) ] F B;
match B(delay) when delay > 0 then B(delay - 1);
match B(delay) when delay <= 0 then F [ Minus B(1) ] F A;
