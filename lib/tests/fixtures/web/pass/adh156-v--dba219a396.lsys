# RESETIUS | ADH156_v { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  v
# RESETIUS |   Axiom /170d\90d/90d\90d/90d\90d/100d/100d\90d/90d\90d/90d\90d
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
