let ANGLE = 36;

axiom Q;

match F then nothing;
match P then Minus Minus F R Plus Plus Plus Plus F S Minus Minus F U;
match Q then F T Plus Plus F R Minus Minus Minus Minus F S Plus Plus;
match R then Plus Plus F P Minus Minus Minus Minus F Q Plus Plus F T;
match S then F U Minus Minus F P Plus Plus Plus Plus F Q Minus Minus;
match T then Plus F U Minus Minus F P Plus;
match U then Minus F Q Plus Plus F T Minus;
