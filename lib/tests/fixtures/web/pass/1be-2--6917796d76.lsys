# RESETIUS |   s=-@0.85F>2[-s][t]-@0.8F>2[--s][+t]-@0.75F>2[s]
# RESETIUS |   t=+<2F[-s][++t]+<2@0.95F[-s][++t]+<2@0.9F[-s][++t]
