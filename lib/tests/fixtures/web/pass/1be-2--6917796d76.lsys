let ANGLE = 12;

axiom X;

match X then ColorIncrement(2) F [ S ] [ T ] ColorIncrement(2) Scale(0.95) F [ S ] [ T ] ColorIncrement(2) Scale(0.9) F [ S ] [ T ] Scale(0.85) F ColorIncrement(-2) [ S ] [ T ];
match S then Minus ColorIncrement(2) F [ Minus Minus S ] [ Plus T ] Minus ColorIncrement(2) Scale(0.95) F [ Minus Minus S ] [ Plus T ] Minus ColorIncrement(2) Scale(0.9) F [ Minus Minus S ] [ Plus T ] Minus Scale(0.85) F ColorIncrement(-2) [ Minus S ] [ T ] Minus Scale(0.8) F ColorIncrement(-2) [ Minus Minus S ] [ Plus T ] Minus Scale(0.75) F ColorIncrement(-2) [ S ];
match T then Plus ColorIncrement(2) F [ Minus S ] [ Plus Plus T ] Plus ColorIncrement(2) Scale(0.95) F [ Minus S ] [ Plus Plus T ] Plus ColorIncrement(2) Scale(0.9) F [ Minus S ] [ Plus Plus T ] Plus Scale(0.85) F ColorIncrement(-2) [ S ] [ Plus T ] Plus Scale(0.8) F ColorIncrement(-2) [ Plus S ] [ Plus Plus T ] Plus Scale(0.75) F ColorIncrement(-2) [ T ];
match F then ColorIncrement(5) F ColorIncrement(5) F ColorIncrement(-5) F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
