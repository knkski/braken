#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf3 {
# RESETIUS | ; order 46
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(7)]Fb
# RESETIUS |   b=F[-B(7)]Fa
# RESETIUS |   F=@1.13F@i1.13
# RESETIUS |   }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(7) ] F B;
match B then F [ Minus B(7) ] F A;
match F then Scale(1.13) F Scale(0.884955752212);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(7) ] F B;
match B(delay) when delay > 0 then B(delay - 1);
match B(delay) when delay <= 0 then F [ Minus B(7) ] F A;
