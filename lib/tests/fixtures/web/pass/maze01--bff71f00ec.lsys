let ANGLE = 120;

axiom Color(40) F Plus Color(48) F Plus Color(56) F;

match F then F Plus F F Minus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
