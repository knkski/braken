let ANGLE = 36;

axiom Plus W Color(10) F Color(12) F Minus Minus X Color(11) F Color(10) F Minus Minus Minus Y Color(10) F Color(11) F Minus Minus Z Color(12) F Color(10) F;

match W then Y Color(10) F Color(11) F Plus Plus Z Color(12) F Color(10) F Minus Minus Minus Minus X Color(11) F Color(10) F [ Minus Y Color(10) F Color(11) F Minus Minus Minus Minus W Color(10) F Color(12) F ] Plus Plus;
match X then Plus Y Color(10) F Color(11) F Minus Minus Z Color(12) F Color(10) F [ Minus Minus Minus W Color(10) F Color(12) F Minus Minus X Color(11) F Color(10) F ] Plus;
match Y then Minus W Color(10) F Color(12) F Plus Plus X Color(11) F Color(10) F [ Plus Plus Plus Y Color(10) F Color(11) F Plus Plus Z Color(12) F Color(10) F ] Minus;
match Z then Minus Minus Y Color(10) F Color(11) F Plus Plus Plus Plus W Color(10) F Color(12) F [ Plus Z Color(12) F Color(10) F Plus Plus Plus Plus X Color(11) F Color(10) F ] Minus Minus X Color(11) F Color(10) F;
match F then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
