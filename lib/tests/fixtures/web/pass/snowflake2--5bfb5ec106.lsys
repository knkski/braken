let ANGLE = 30;

axiom F;

match F then Plus Plus InvertTurns F InvertTurns F Minus Minus F Minus Minus F Scale(0.57735026919) TurnAround Plus F InvertTurns F Minus Minus F Minus Minus F InvertTurns Plus Plus Plus Scale(1.73205080757) F Scale(0.57735026919) TurnAround Plus F InvertTurns F Scale(1.73205080757) TurnAround Plus F InvertTurns F;
