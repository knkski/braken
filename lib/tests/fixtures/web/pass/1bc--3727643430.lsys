#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1bc { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom X
# RESETIUS |   X=-<2F[+X][-X]-<2F[+X][-X]-<2F[+X][-X]+F>2[+X][-X]+F>2[+X][-X]+F>2[+X][-X]
# RESETIUS |   F=<2F@.9985F>2@.9945F
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then Minus ColorIncrement(2) F [ Plus X ] [ Minus X ] Minus ColorIncrement(2) F [ Plus X ] [ Minus X ] Minus ColorIncrement(2) F [ Plus X ] [ Minus X ] Plus F ColorIncrement(-2) [ Plus X ] [ Minus X ] Plus F ColorIncrement(-2) [ Plus X ] [ Minus X ] Plus F ColorIncrement(-2) [ Plus X ] [ Minus X ];
match F then ColorIncrement(2) F Scale(0.9985) F ColorIncrement(-2) Scale(0.9945) F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
