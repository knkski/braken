let ANGLE = 36;

axiom Q;

match P then Minus Minus R Plus Plus Plus Plus S Minus Minus U;
match Q then T Plus Plus R Minus Minus Minus Minus S Plus Plus;
match R then Plus Plus P Minus Minus Minus Minus Q Plus Plus T;
match S then U Minus Minus P Plus Plus Plus Plus Q Minus Minus;
match T then Plus U Minus Minus P Plus;
match U then Minus Q Plus Plus T Minus;
