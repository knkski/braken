# WOLFRAM-FUNCTION-R | ResourceFunction["LSystem"][{"X" -> "XFYFX+F+YFXFY-F-XFYFX", "Y" -> "YFXFY-F-XFYFX+F+YFXFY"}, "X", 3, 90]
