# ELM | sierpinskiArrowhead =
# ELM |     { default
# ELM |         | rules =
# ELM |             [ ( 'X', "YF+XF+Y" )
# ELM |             , ( 'Y', "XF-YF-X" )
# ELM |             ]
# ELM |         , axiom = "YF"
# ELM |         , iterations = 7
# ELM |         , lineLength = 1
# ELM |         , turningAngle = Angle.fromDegrees 60
# ELM |         , windowPosition = { x = -4, y = -121 }
# ELM |         , windowSize = 135
# ELM |     }
#
# Original Paul Bourke L-system manual/catalog:
# BOURKE | axiom = YF
# BOURKE | X -> YF+XF+Y
# BOURKE | Y -> XF-YF-X
# BOURKE | angle = 60
#
let ANGLE = 60;

axiom Y F;

match X then Y F Plus X F Plus Y;
match Y then X F Minus Y F Minus X;
