let ANGLE = 7.2;

axiom Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Color(6) X;

match X then F [ Scale(0.5) Plus Plus Plus Plus Plus Plus Plus Plus Plus X Scale(0.5) F Plus Plus Plus Plus Plus Plus Plus Color(48) F Minus Minus F TurnAround Plus Plus Plus Plus F Minus Minus Minus Minus Minus Minus F ] Minus F [ Scale(0.4) Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus InvertTurns X Scale(0.5) F Plus Plus Plus Plus Plus Plus Plus Color(48) F Minus Minus F TurnAround Plus Plus Plus Plus F Minus Minus Minus Minus Minus Minus F ] Scale(0.6) X;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
