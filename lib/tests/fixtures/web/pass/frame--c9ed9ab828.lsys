# RESETIUS | Frame { ; William McWorter
# RESETIUS |   ; made from Moore's spacefilling curve
# RESETIUS | ; order 4
# RESETIUS |   Angle 4
# RESETIUS |   Axiom YXY-YXY-YXY-YXY
# RESETIUS |   F=
# RESETIUS |   X=FX+FX+FXFYFX+FXFY-FY-FY-
# RESETIUS |   Y=+FX+FX+FXFY-FYFXFY-FY-FY
# RESETIUS |   }
#
let ANGLE = 90;

axiom Y X Y Minus Y X Y Minus Y X Y Minus Y X Y;

match F then nothing;
match X then F X Plus F X Plus F X F Y F X Plus F X F Y Minus F Y Minus F Y Minus;
match Y then Plus F X Plus F X Plus F X F Y Minus F Y F X F Y Minus F Y Minus F Y;
