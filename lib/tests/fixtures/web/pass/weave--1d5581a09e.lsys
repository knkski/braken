let ANGLE = 90;

axiom Z;

match Z then X;
match X then Minus Minus G Plus G Plus Scale(7) F Scale(0.142857142857) Plus G Plus G Plus Plus X Plus Minus Minus G Minus G Minus Scale(7) F Scale(0.142857142857) Minus G Minus G Plus Plus Y;
match Y then Minus Minus G Plus G Plus Scale(7) F Scale(0.142857142857) Plus G Plus G Plus Plus X Minus Minus Minus G Minus G Minus Scale(7) F Scale(0.142857142857) Minus G Minus G Plus Plus Y;
match F then nothing;
match G then nothing;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
