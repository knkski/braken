# JKUBIN | 
# JKUBIN | AXIOM(⟦TRIANGULAR_PATTERN⟧, ⟦F---W---F---Y⟧)
# JKUBIN | RULE(⟦W⟧, ⟦+++X--F--ZFX+⟧)
# JKUBIN | RULE(⟦X⟧, ⟦---W++F++YFW-⟧)
# JKUBIN | RULE(⟦Y⟧, ⟦+ZFX--F--Z+++⟧)
# JKUBIN | RULE(⟦Z⟧, ⟦-YFW++F++Y---⟧)
# JKUBIN | 
# JKUBIN | divert⟦⟧dnl turtle configuration
# JKUBIN | ANGLE(30),dnl
# JKUBIN | "seth":180,dnl
# JKUBIN | 
# JKUBIN | TRIANGULAR_PATTERN(6)
#
let ANGLE = 30;

axiom F Minus Minus Minus W Minus Minus Minus F Minus Minus Minus Y;

match W then Plus Plus Plus X Minus Minus F Minus Minus HalfForward F X Plus;
match X then Minus Minus Minus W Plus Plus F Plus Plus Y F W Minus;
match Y then Plus HalfForward F X Minus Minus F Minus Minus HalfForward Plus Plus Plus;
match Z then Minus Y F W Plus Plus F Plus Plus Y Minus Minus Minus;
