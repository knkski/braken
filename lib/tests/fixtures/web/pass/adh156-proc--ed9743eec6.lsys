# RESETIUS | ADH156_proc { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  %
# RESETIUS |   Axiom /90d/90d/90d/90ddd/120ddddd\120ddd\90d\90d\90d
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
