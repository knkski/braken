let ANGLE = 30;

axiom W;

match W then Plus Plus Plus X Minus Minus F Minus Minus Z F X Plus;
match X then Minus Minus Minus W Plus Plus F Plus Plus Y F W Minus;
match Y then Plus Z F X Minus Minus F Minus Minus Z Plus Plus Plus;
match Z then Minus Y F W Plus Plus F Plus Plus Y Minus Minus Minus;
