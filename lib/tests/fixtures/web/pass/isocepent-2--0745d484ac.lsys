let ANGLE = 36;

axiom S;

match S then Z;
match W then Plus Plus [ Minus Scale(1.618033989) F Scale(0.618033988654) Plus Plus Plus Plus F ] F X Minus Minus [ Plus Plus Scale(1.618033989) F Minus Minus Minus Minus F ] F W Minus Minus [ Minus Minus Scale(1.618033989) F Plus Plus Plus Plus F ] F Y Plus Plus;
match X then Minus [ Plus Scale(1.618033989) F Scale(0.618033988654) Minus Minus Minus Minus F ] F Z Plus Plus [ Minus Minus Scale(1.618033989) F Plus Plus Plus Plus F ] F Y Minus;
match Y then Minus Minus [ Plus Scale(1.618033989) F Scale(0.618033988349) Minus Minus Minus Minus F ] F Z Plus Plus [ Minus Minus Scale(1.618033989) F Plus Plus Plus Plus F ] F Y Plus Plus [ Plus Plus Scale(1.618033989) F Minus Minus Minus Minus F ] F W Minus Minus;
match Z then Plus [ Minus Scale(1.618033989) F Scale(0.618033988654) Plus Plus Plus Plus F ] F X Minus Minus [ Plus Plus Scale(1.618033989) F Minus Minus Minus Minus F ] F W Plus;
match F then nothing;
