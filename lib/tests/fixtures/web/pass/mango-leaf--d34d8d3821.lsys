let ANGLE = 60;

axiom Y Minus Minus Minus Y;

match X then PolygonBegin F Minus F PolygonEnd PolygonBegin F Minus F PolygonEnd Minus Minus [ Minus Minus X ] PolygonBegin F Minus F PolygonEnd PolygonBegin F Minus F PolygonEnd Minus Minus PolygonBegin F Minus F PolygonEnd PolygonBegin F Minus F PolygonEnd Minus Minus;
match Y then f Minus F Plus X Plus F Minus f Y;
