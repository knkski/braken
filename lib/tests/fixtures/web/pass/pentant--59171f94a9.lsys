let ANGLE = 72;

axiom X Minus X Minus X Minus X Minus X;

match F then nothing;
match X then F X Minus F X Minus F X Plus F Y Plus F Y Plus F X Minus F X;
match Y then F Y Plus F Y Minus F X Minus F X Minus F Y Plus F Y Plus F Y;
