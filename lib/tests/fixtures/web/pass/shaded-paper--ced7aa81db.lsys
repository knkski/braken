# RESETIUS |     axiom c16FX--FX--FX--FX--
# RESETIUS | 
# RESETIUS |     F=
# RESETIUS |     X=-FY<1++FY>1-
# RESETIUS |     Y=+FX<1--FX>1+
# RESETIUS |   }
