let ANGLE = 45;

axiom Color(16) F X Minus Minus F X Minus Minus F X Minus Minus F X Minus Minus;

match F then nothing;
match X then Minus F Y ColorIncrement(1) Plus Plus F Y ColorIncrement(-1) Minus;
match Y then Plus F X ColorIncrement(1) Minus Minus F X ColorIncrement(-1) Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
