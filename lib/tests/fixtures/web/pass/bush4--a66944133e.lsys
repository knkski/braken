let ANGLE = 20;

axiom V HalfForward F F F;

match V then [ Plus Plus Plus W ] [ Minus Minus Minus W ] Y V;
match W then Plus X [ Minus W ] HalfForward;
match X then Minus W [ Plus X ] HalfForward;
match Y then Y HalfForward;
match Z then [ Minus F F F ] [ Plus F F F ] F;
