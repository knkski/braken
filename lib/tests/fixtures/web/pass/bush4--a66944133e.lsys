# ELM | bush4 =
# ELM |     { default
# ELM |         | rules =
# ELM |             [ ( 'V', "[+++W][---W]YV" )
# ELM |             , ( 'W', "+X[-W]Z" )
# ELM |             , ( 'X', "-W[+X]Z" )
# ELM |             , ( 'Y', "YZ" )
# ELM |             , ( 'Z', "[-FFF][+FFF]F" )
# ELM |             ]
# ELM |         , axiom = "VZFFF"
# ELM |         , iterations = 10
# ELM |         , lineLength = 2
# ELM |         , startHeading = Angle.right
# ELM |         , turningAngle = Angle.fromDegrees 20
# ELM |         , windowPosition = { x = -48, y = -12 }
# ELM |         , windowSize = 102
# ELM |     }
