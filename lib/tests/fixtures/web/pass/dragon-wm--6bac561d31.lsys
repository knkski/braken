# RESETIUS | Dragon-wm { ; William McWorter
# RESETIUS |   Angle 4
# RESETIUS |   Axiom X
# RESETIUS |   F=
# RESETIUS |   X=FX+FY ; Do first half, turn left 90 degrees, do second half
# RESETIUS |   Y=FX-FY ; Trace first half (X) backwards; Y backwards is X,
# RESETIUS |           ; left turn becomes right turn, and X backwards is Y
# RESETIUS |   }
#
let ANGLE = 90;

axiom X;

match F then nothing;
match X then F X Plus F Y;
match Y then F X Minus F Y;
