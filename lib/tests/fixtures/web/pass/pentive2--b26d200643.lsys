let ANGLE = 36;

axiom X;

match F then nothing;
match X then F Y Plus Plus F Z Minus Minus Minus Minus F W Plus Plus;
match Y then Plus F W Minus Minus F U Plus;
match Z then Plus Plus F V Minus Minus Minus Minus F X Plus Plus F Y;
