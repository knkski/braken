let ANGLE = 24;

axiom TurnAround X;

match X then F [ Plus Plus S ] [ Minus Minus T ] Scale(0.9326) F [ Plus S ] [ Minus T ] Scale(0.8557) F [ S ] [ T ] Scale(0.7788) F [ Minus S ];
match S then Plus ColorIncrement(1) F [ S ] [ T ] ColorIncrement(5) Scale(0.9326) F [ S ] [ T ] ColorIncrement(10) Scale(0.8557) F [ S ] [ T ] Scale(0.7788) F ColorIncrement(-1) [ S ] [ T ] Scale(0.7019) F ColorIncrement(-5) [ S ] [ T ] Scale(0.625) F ColorIncrement(-10) [ S ] [ T ] Scale(0.625) F [ Minus S ];
match T then Minus ColorIncrement(1) F [ S ] [ T ] ColorIncrement(5) Scale(0.9326) F [ S ] [ T ] ColorIncrement(10) Scale(0.8557) F [ S ] [ T ] Scale(0.7788) F ColorIncrement(-1) [ S ] [ T ] Scale(0.7019) F ColorIncrement(-5) [ S ] [ T ] Scale(0.625) F ColorIncrement(-10) [ S ] [ T ] Scale(0.625) F [ Minus S ];
match F then ColorIncrement(10) F F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
