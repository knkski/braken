let ANGLE = 36;

axiom Color(39) Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus;

match A then ColorIncrement(1) Minus Minus Scale(0.4472316) B;
match B then [ I ] F X Plus Plus [ I ] F X Plus Plus [ I ] F X Plus Plus [ I ] F X [ Scale(0.618034) Minus H ] Plus Plus [ I ] F X;
match H then [ I ] F X [ Scale(0.618034) Minus H ] Plus Plus [ I ] F X Plus Plus [ I ] F X Plus Plus [ I ] F X Plus Plus [ I ] F X;
match I then ColorIncrement(1) Plus G [ Scale(0.236068) Minus J ] Plus Plus Scale(0.381966) K;
match J then H;
match K then I;
match F then nothing;
match X then F Y;
match Y then F W;
match W then G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
