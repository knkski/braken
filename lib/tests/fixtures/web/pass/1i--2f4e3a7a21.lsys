# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1i { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom +++++X
# RESETIUS |   X=-<1F[-X]+<3F[-X]-<5F[+X]+F>1[+X]+F>3[-X]-F>5[-X]
# RESETIUS |   F=<10FFF>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom Plus Plus Plus Plus Plus X;

match X then Minus ColorIncrement(1) F [ Minus X ] Plus ColorIncrement(3) F [ Minus X ] Minus ColorIncrement(5) F [ Plus X ] Plus F ColorIncrement(-1) [ Plus X ] Plus F ColorIncrement(-3) [ Minus X ] Minus F ColorIncrement(-5) [ Minus X ];
match F then ColorIncrement(10) F F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
