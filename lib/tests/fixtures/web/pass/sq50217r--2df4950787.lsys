let ANGLE = 90;

axiom Plus Color(53) F Plus G Plus Color(12) F;

match F then G G G G G TurnAround F F F F F TurnAround G G G G G Plus G Plus F F G G F TurnAround F G G F F Plus G Plus F G F G G TurnAround G G F G F Plus G Plus F F G F G TurnAround G F G F F Plus G Plus G F F G G TurnAround G G F F G Plus G Plus G G G G G Plus G G G G G Plus G G G G G;
match G then G G G G G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
