let ANGLE = 24;

axiom X;

match X then ColorIncrement(-5) F [ Minus X ] [ Plus X ] ColorIncrement(-5) F [ Minus Minus X ] [ Plus Plus X ] ColorIncrement(-5) F ColorIncrement(5) [ Minus Minus Minus X ] [ Plus Plus Plus X ] F ColorIncrement(5) [ Minus Minus Minus Minus X ] [ Plus Plus Plus Plus X ] F ColorIncrement(5) [ Minus Minus Minus Minus Minus X ] [ Plus Plus Plus Plus Plus X ];
match F then Color(52) F Scale(0.9975) Color(32) F Scale(0.9935) Color(11) F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
