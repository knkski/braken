#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Feather { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom F
# RESETIUS |   X=-<10F[-X]-F>10[-X]
# RESETIUS |   F=+<10F[-X]-F>10[-X]
# RESETIUS |   }
#
let ANGLE = 12;

axiom F;

match X then Minus ColorIncrement(10) F [ Minus X ] Minus F ColorIncrement(-10) [ Minus X ];
match F then Plus ColorIncrement(10) F [ Minus X ] Minus F ColorIncrement(-10) [ Minus X ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
