let ANGLE = 36;

axiom W;

match W then Plus Plus F X F P Minus Minus F W Minus Minus F P F Y Plus Plus;
match X then Minus F Z Plus Scale(0.618) F P Scale(1.61812297735) Plus F Y Minus;
match Y then Minus Minus F Z F P Plus Plus F Y Plus Plus F P F W Minus Minus;
match Z then Plus F X Minus Scale(0.618) F P Scale(1.61812297735) Minus F W Plus;
match F then nothing;
match P then F P;
