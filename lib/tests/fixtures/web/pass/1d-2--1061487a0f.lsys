# RESETIUS | 1d_2 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom x
# RESETIUS |   x=F[s][t]
# RESETIUS |   s=-<5F[s][t]+<5F[s][t]-F[s][t]
# RESETIUS |   s=+F>5[s][t]-F>5[s][t]+F[s][t]
# RESETIUS |   t=+<5F[s][t]-<5F[s][t]+F[s][t]
# RESETIUS |   t=-F>5[s][t]+F>5[s][t]-F[s][t]
# RESETIUS |   f=FFFF
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then F [ S ] [ T ];
match S then Minus ColorIncrement(5) F [ S ] [ T ] Plus ColorIncrement(5) F [ S ] [ T ] Minus F [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ] Plus F [ S ] [ T ];
match T then Plus ColorIncrement(5) F [ S ] [ T ] Minus ColorIncrement(5) F [ S ] [ T ] Plus F [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ] Minus F [ S ] [ T ];
match F then F F F F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
