let ANGLE = 36;

axiom W;

match F then nothing;
match W then Plus Plus Color(15) F X Minus Minus Color(48) F W Minus Minus Color(48) F Y Plus Plus;
match X then Minus Color(15) F Z Plus Plus Color(40) F Y Minus;
match Y then Minus Minus Color(15) F Z Plus Plus Color(40) F Y Plus Plus Color(48) F W Minus Minus;
match Z then Plus Color(15) F X Minus Minus Color(40) F W Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
