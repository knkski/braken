#
# Original Prusinkiewicz et al., L-systems: From the Theory to Visual Models of Plants (1996):
# SCHOLARLY | ω : F A(0)
# SCHOLARLY | p1 : A(v) -> [-F B(v)][+F B(v)] F A(v+1)
# SCHOLARLY | p2 : B(v) : v>0 -> F B(v-1)
#
let ANGLE = 45;

axiom F A(0);

match A(v) then [ Minus F B(v) ] [ Plus F B(v) ] F A(v+1);
match B(v) when v > 0 then F B(v-1);
