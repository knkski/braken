#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH114 { ; Anthony Hanmer 2000
# RESETIUS |   Angle 4 ;
# RESETIUS |   Axiom f--h+f--h+f--h+f--h
# RESETIUS |   f=f+@.8f--g+@1.25f
# RESETIUS |   h=f-@.8f++g-@1.25f
# RESETIUS |   }
#
let ANGLE = 90;

axiom F Minus Minus H Plus F Minus Minus H Plus F Minus Minus H Plus F Minus Minus H;

match F then F Plus Scale(0.8) F Minus Minus G Plus Scale(1.25) F;
match H then F Minus Scale(0.8) F Plus Plus G Minus Scale(1.25) F;
