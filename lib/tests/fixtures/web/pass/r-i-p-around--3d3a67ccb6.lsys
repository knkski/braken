let ANGLE = 90;

axiom F Y Minus F Y Minus F Y Minus F Y Minus;

match F then nothing;
match Y then F Y Minus F Y Plus F X Plus F Y Minus F Y;
match X then F A [ Minus Y Minus Y ] Plus F F X Minus F X Minus F X F A [ Minus Y Minus Y ] Plus F;
match A then F A Plus F F X Minus F X F A Plus F Minus;
