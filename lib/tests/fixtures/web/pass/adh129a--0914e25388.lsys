# RESETIUS | ADH129a { ; Anthony Hanmer 2000
# RESETIUS |   Angle 8 ;
# RESETIUS |   Axiom -x--x--x--x
# RESETIUS |   x=x+f+y-f-x
# RESETIUS |   y=y+f+x-f-y
# RESETIUS |   }
