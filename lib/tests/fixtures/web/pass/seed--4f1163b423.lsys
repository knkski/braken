let ANGLE = 7.2;

axiom S T;

match S then ColorIncrement(10) X [ Plus Plus Plus Plus Plus S ] [ Minus Minus Minus Minus Minus S ] ColorIncrement(10) X [ Plus Plus Plus Plus S ] [ Minus Minus Minus Minus S ] ColorIncrement(10) X ColorIncrement(-10) [ Plus Plus Plus S ] [ Minus Minus Minus S ] X ColorIncrement(-10) [ Plus Plus S ] [ Minus Minus S ] X ColorIncrement(-10) [ Plus S ] [ Minus S ];
match T then ColorIncrement(10) X [ Plus Plus Plus Plus Plus T ] [ Minus Minus Minus Minus Minus T ] ColorIncrement(10) X [ Plus Plus Plus Plus T ] [ Minus Minus Minus Minus T ] ColorIncrement(10) X ColorIncrement(-10) [ Plus Plus Plus T ] [ Minus Minus Minus T ] X ColorIncrement(-10) [ Plus Plus T ] [ Minus Minus T ] X ColorIncrement(-10) [ Plus T ] [ Minus T ];
match X then Scale(0.75) F Scale(0.85) F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
