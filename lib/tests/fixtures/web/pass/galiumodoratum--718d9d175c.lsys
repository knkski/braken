let ANGLE = 3;

axiom ColorPrevious A TurtleNumber6 L A A TurtleNumber8 M A A TurtleNumber8 M D;

match A then a;
match a then F A;
match L then TurtleNumber20 RollRight [ TurtleNumber33 PitchUp WidthDecrease WidthDecrease [ n ] o ];
match n then B;
match o then C;
match M then TurtleNumber15 RollRight [ TurtleNumber33 PitchUp WidthDecrease WidthDecrease [ B ] C ];
match B then b Minus B;
match b then [ [ x g PitchUp PolygonBegin F ] Minus x [ g Vertex ] Vertex PolygonEnd ] b;
match C then c Plus C;
match c then [ [ x g PitchUp PolygonBegin F ] Plus x [ g Vertex ] Vertex PolygonEnd ] c;
match D then Query J J J TurtleNumber0 Cut TurtleNumber13 ColorPrevious Surface s;
match J then WidthDecrease TurtleNumber40 RollRight [ TurtleNumber12 PitchUp y D ];
match x then g PitchUp x;
match y then F PitchUp y;
