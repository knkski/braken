#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Hiwayint { ; William McWorter
# RESETIUS |   Angle 4
# RESETIUS |   Axiom s
# RESETIUS |   F=
# RESETIUS |   s=x+F-t
# RESETIUS |   t=++F--u+F-t
# RESETIUS |   u=z-F+v
# RESETIUS |   v=Fs-F+v
# RESETIUS |   w=Fsw
# RESETIUS |   x=xy
# RESETIUS |   y=++F--uy
# RESETIUS |   z=zw
# RESETIUS |   }
#
let ANGLE = 90;

axiom S;

match F then nothing;
match S then X Plus F Minus T;
match T then Plus Plus F Minus Minus U Plus F Minus T;
match U then Z Minus F Plus V;
match V then F S Minus F Plus V;
match W then F S W;
match X then X Y;
match Y then Plus Plus F Minus Minus U Y;
match Z then Z W;
