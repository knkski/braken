let ANGLE = 45;

axiom Z;

match Z then X;
match X then Plus [ Color(40) Minus Scale(0.5) G Plus Plus Scale(2.414) G TurnAround Scale(1.41421356237) F Minus Minus F Minus Minus Minus Scale(1.41421356237) F ] Y Minus F W Minus [ Color(40) Minus Scale(0.5) G Plus Plus Scale(2.414) G TurnAround Scale(1.41421356237) F Minus Minus F Minus Minus Minus Scale(1.41421356237) F ] Y Plus;
match Y then Minus [ Color(40) Plus Scale(0.5) G Minus Minus Scale(2.414) G TurnAround Scale(1.41421356237) F Plus Plus F Plus Plus Plus Scale(1.41421356237) F ] X Plus F W Plus [ Color(40) Plus Scale(0.5) G Minus Minus Scale(2.414) G TurnAround Scale(1.41421356237) F Plus Plus F Plus Plus Plus Scale(1.41421356237) F ] X Minus;
match W then F W;
match F then nothing;
match G then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
