let ANGLE = 7.34693877551;

axiom Color(255) X;

match X then X ColorIncrement(1) G Plus Scale(0.9879) X [ ExplicitPlus(120) ColorIncrement(1) F Minus ColorIncrement(1) F Minus ColorIncrement(1) F Minus ColorIncrement(1) F Minus ColorIncrement(1) F Minus ColorIncrement(1) F ExplicitMinus(120) Plus ColorIncrement(1) F Plus ColorIncrement(1) F Plus ColorIncrement(1) F Plus Plus Plus Plus Plus Plus Plus ColorIncrement(1) F Plus ColorIncrement(1) F Plus ColorIncrement(1) F ];
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
