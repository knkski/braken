#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf6 {
# RESETIUS | ; order 21
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(2)][-A(2)]FA(0)
# RESETIUS |   F=@1.36F@i1.36
# RESETIUS | }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(2) ] [ Minus A(2) ] F A(0);
match F then Scale(1.36) F Scale(0.735294117647);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(2) ] [ Minus A(2) ] F A(0);
