let ANGLE = 36;

axiom R;

match R then X;
match X then F X Plus Plus F Y Minus Minus F X Minus Minus F X Minus Minus F X Plus F Y Plus Plus Plus;
match Y then Minus Minus Minus F X Minus F Y Plus Plus F Y Plus Plus F Y Plus Plus F X Minus Minus F Y;
match F then nothing;
match P then F P;
