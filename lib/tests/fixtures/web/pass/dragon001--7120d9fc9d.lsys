#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Dragon001 {
# RESETIUS |   Angle 4
# RESETIUS |   Axiom r
# RESETIUS |   r=c40fx-<8yf-<8fx-<4yf
# RESETIUS |   x=x+yf+fx-yf-fx+yf-fx-yf
# RESETIUS |   y=fx+yf+fx-yf+fx+yf-fx-y
# RESETIUS |   }
#
let ANGLE = 90;

axiom R;

match R then Color(40) F X Minus ColorIncrement(8) Y F Minus ColorIncrement(8) F X Minus ColorIncrement(4) Y F;
match X then X Plus Y F Plus F X Minus Y F Minus F X Plus Y F Minus F X Minus Y F;
match Y then F X Plus Y F Plus F X Minus Y F Plus F X Plus Y F Minus F X Minus Y;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
