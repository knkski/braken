let ANGLE = 90;

axiom Z;

match Z then Minus Color(32) Y Color(15) F Plus Color(32) X Color(15) F Color(32) X Plus Color(15) F Color(32) Y Minus;
match X then Minus Y F Plus X F X Plus F Y Minus;
match Y then Plus X F Minus Y F Y Minus F X Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
