# Note     : The source renderer draws every non-reserved letter; terminal model rules are metadata, not derivation productions.
#
# Original propfeds L-systems Renderer manual/gallery:
# SCHOLARLY | new LSystem('[X]+[X]+[X]+[X]+[X]+[X]', [
# SCHOLARLY |             'X=F[+F][-F]X',
# SCHOLARLY |             'F=F[+i][-i]F',
# SCHOLARLY |             'i=Ii,IIi'
# SCHOLARLY |         ], 60, 0, 'i')
#
let ANGLE = 60;

axiom [ X ] Plus [ X ] Plus [ X ] Plus [ X ] Plus [ X ] Plus [ X ];

match X then F [ Plus F ] [ Minus F ] X;
match F then F [ Plus i ] [ Minus i ] F;
match i weight 1 then I i;
match i weight 1 then I I i;
