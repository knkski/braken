let ANGLE = 36;

axiom Color(17) A;

match A then [ X ] G Plus Plus [ X ] G Plus Plus [ X ] G Plus Plus [ X ] G Plus Plus [ X ] G Plus Plus;
match W then F V;
match V then G;
match F then nothing;
match X then Scale(0.276393) [ A ] F W Plus Plus F W [ Minus Minus Minus Y ] Plus Plus F W Plus Plus F W Plus Plus F W Plus Plus;
match Y then Scale(0.618034) [ A ] F W Plus Plus F W Plus Plus F W [ ColorIncrement(2) Minus Minus Minus Z ] Plus Plus F W Plus Plus F W Plus Plus;
match Z then Scale(0.618034) [ A ] F W Plus Plus F W Plus Plus F W [ Minus Minus Minus Y ] Plus Plus F W Plus Plus F W Plus Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
