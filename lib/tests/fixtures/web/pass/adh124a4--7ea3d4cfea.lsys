# ID       : LSYS-7EA3D4CFEAD8
# Name     : ADH124a4
# Source   : resetius/lsystem Fractint-rule catalog (commit f7fa950) | fractals/hanmer3_0.ls, section ADH124a4 (#31) | https://github.com/resetius/lsystem/blob/f7fa950/fractals/hanmer3_0.ls
# Formalism: Fractint-style context-free turtle string
# Parse    : pass; validator=corpus-static
# Execute  : pass; engine=bounded-python-context-free; output=no-drawable-segments
# Render   : not-applicable; reason=expanded word contains no drawable segments
# Fidelity : equivalent
# Features : context-free, deterministic, fractint-turtle
# Angle    : 60
# Heading  : 0
# Draw     : F D
# Move     : G M
# Profile  : turtle2d-fractint
# Fingerprint: sha256:7ea3d4cfead89775440d366745ca5e3284701042cfe9ac674116ed7ee2935ed5
#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH124a4 { ; Anthony Hanmer 2000
# RESETIUS | ; order 4
# RESETIUS |   Angle 6 ; Odd orders cancel to a blank screen -
# RESETIUS |   Axiom f-f-f-f-f-f ; only even orders show...
# RESETIUS |   f=h--h++h++h--h
# RESETIUS |   h=f++f--f--f++f
# RESETIUS |   }
#
let ANGLE = 60;

axiom F Minus F Minus F Minus F Minus F Minus F;

match F then H Minus Minus H Plus Plus H Plus Plus H Minus Minus H;
match H then F Plus Plus F Minus Minus F Minus Minus F Plus Plus F;
