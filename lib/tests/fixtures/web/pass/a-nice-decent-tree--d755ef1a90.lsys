let ANGLE = 15;

axiom f A;

match A then PitchUp f WidthIncrease(30) B RollLeft RollLeft B RollLeft RollLeft RollLeft RollLeft RollLeft B;
match B then [ PitchUp PitchUp f L RollLeft RollLeft RollLeft RollLeft RollLeft RollLeft A L ];
match L weight 1 then [ PitchUp(60) [ Object(0.3) ] Plus(50) Object(0.28) ];
match L weight 1 then [ PitchUp(60) Object(0.3) ];
match L weight 1 then [ PitchDown(70) Object(0.3) ];
