let ANGLE = 12;

axiom a F;

match a then F F F F F v [ Plus Plus Plus h ] [ Minus Minus Minus q ] f b;
match b then F F F F F v [ Plus Plus Plus h ] [ Minus Minus Minus q ] f c;
match c then F F F F F v [ Plus Plus Plus f a ] f d;
