match g then F F F F F v [ Minus Minus Minus f a ] f a;
match h then i f F F;
match i then f F F F [ Minus Minus m ] j;
match j then f F F F [ Minus Minus n ] k;
match k then f F F F [ Minus Minus o ] l;
match l then f F F F [ Minus Minus p ];
match m then f F n;
