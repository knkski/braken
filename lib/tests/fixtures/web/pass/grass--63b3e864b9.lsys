let ANGLE = 24;

axiom X;

match X then ColorIncrement(-5) F [ Minus X ] [ Plus X ] ColorIncrement(-5) Scale(0.75) F [ Minus X ] [ Plus X ] ColorIncrement(-5) Scale(0.75) F [ Minus X ] [ Plus X ] ColorIncrement(5) Scale(0.75) F [ Minus X ] [ Plus X ] ColorIncrement(5) Scale(0.75) F [ Minus X ] [ Plus X ] ColorIncrement(5) Scale(0.75) F [ X ];
match F then F F Scale(0.9985) F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
