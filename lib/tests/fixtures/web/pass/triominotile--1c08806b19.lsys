let ANGLE = 90;

axiom R;

match R then X;
match X then X F F [ G Plus X ] Plus F Plus F TurnAround X TurnAround Minus F Plus F [ Minus G TurnAround X ] Plus F F Plus;
match F then G;
match G then G G;
