# RESETIUS |   Axiom c09f-c10h-c09f-c10h-c09f-c10h
# RESETIUS |   f=f+f-f
# RESETIUS |   h=f-f+f
# RESETIUS |   }
#
let ANGLE = 120;

axiom Color(9) F Minus Color(10) H Minus Color(9) F Minus Color(10) H Minus Color(9) F Minus Color(10) H;

match F then F Plus F Minus F;
match H then F Minus F Plus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
