let ANGLE = 72;

axiom Color(79) ExplicitPlus(36) D [ X ] ExplicitPlus(72) D [ X ] ExplicitPlus(72) D [ X ] ExplicitPlus(72) D [ X ] ExplicitPlus(72) D [ X ];

match X then ExplicitMinus(3) D [ ExplicitMinus(72) InvertTurns Y ] ExplicitMinus(1) Scale(0.333333333333) D Scale(3) [ ExplicitPlus(72) Y ] Scale(0.786151384913) ColorIncrement(-1) X Scale(1.27201963794);
match Y then Z;
match Z then A;
match A then Scale(0.381966) X;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
