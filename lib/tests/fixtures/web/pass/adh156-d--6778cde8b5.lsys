#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | ADH156_D { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  D
# RESETIUS |   Axiom \90ddddd/90d/90d\90d/90d\90d/90d/90d\90d/90d\90d/90d
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
#
let ANGLE = 10;

axiom ExplicitPlus(90) D D D D D ExplicitMinus(90) D ExplicitMinus(90) D ExplicitPlus(90) D ExplicitMinus(90) D ExplicitPlus(90) D ExplicitMinus(90) D ExplicitMinus(90) D ExplicitPlus(90) D ExplicitMinus(90) D ExplicitPlus(90) D ExplicitMinus(90) D;

match D then D ExplicitPlus(80) D ExplicitMinus(160) D ExplicitPlus(80) D;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
