let ANGLE = 7.2;

axiom Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus X;

match X then F [ Scale(0.5) Plus Plus Plus Plus Plus Plus Plus Plus Plus X ] Minus F [ Scale(0.4) Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus InvertTurns X ] Scale(0.6) X;
