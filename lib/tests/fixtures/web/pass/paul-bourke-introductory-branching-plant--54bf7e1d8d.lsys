# FRACTINT |   F=FF
# FRACTINT |   }
#
# Original Paul Bourke L-system manual/catalog:
# BOURKE | Axiom X
# BOURKE | F -> FF
# BOURKE | X -> F-[[X]+X]+F[+FX]-X
# BOURKE | theta = 22.5
#
