# OFX | <settings>
# OFX | <treed>
# OFX | <rule>
# OFX | X -&gt; F-[[X]+X]+F[+FX]-X;
# OFX | F -&gt; FF;
# OFX | </rule>
# OFX | <axiom>X</axiom>
# OFX | <maxDepth>7</maxDepth>
# OFX | <theta>22.5</theta>
# OFX | <bg_color>39, 128, 123, 255</bg_color>
# OFX | 		<tree_color>150, 180, 0, 255</tree_color>
# OFX | 	<depth>4</depth>
# OFX | 	</treed>
# OFX | </settings>
