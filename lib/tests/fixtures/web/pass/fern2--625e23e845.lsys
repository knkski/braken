let ANGLE = 12;

axiom X;

match X then ColorIncrement(5) Scale(0.9326) F [ Plus L ] [ Minus R ] ColorIncrement(5) Scale(0.8557) F [ Plus L ] [ Minus R ] ColorIncrement(5) Scale(0.7788) F ColorIncrement(-5) [ Plus L ] [ Minus R ] Scale(0.7619) F ColorIncrement(-5) [ Plus L ] [ Minus R ] Scale(0.725) F ColorIncrement(-5) [ L ] [ R ] F X;
match L then Plus ColorIncrement(5) F [ Plus L ] [ Minus Minus Minus L ] Plus ColorIncrement(5) Scale(0.9326) F [ Plus L ] [ Minus Minus Minus L ] Plus ColorIncrement(5) Scale(0.9026) F [ Plus L ] [ Minus Minus Minus L ] Plus Scale(0.9326) F ColorIncrement(-5) [ Plus L ] [ Minus Minus Minus L ] Plus Scale(0.8557) F ColorIncrement(-5) [ L ] [ Minus Minus L ] Plus Scale(0.7788) F ColorIncrement(-5) [ Minus L ];
match R then Minus ColorIncrement(5) F [ Plus Plus Plus R ] [ Minus R ] Minus ColorIncrement(5) Scale(0.9326) F [ Plus Plus Plus R ] [ Minus R ] Minus ColorIncrement(5) Scale(0.9326) F [ Plus Plus Plus R ] [ Minus R ] Minus Scale(0.9326) F ColorIncrement(-5) [ Plus Plus Plus R ] [ Minus R ] Minus Scale(0.8557) F ColorIncrement(-5) [ Plus Plus R ] [ R ] Minus Scale(0.7788) F ColorIncrement(-5) [ Plus R ];
match F then ColorIncrement(20) F ColorIncrement(20) F ColorIncrement(-20) F ColorIncrement(-20);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
