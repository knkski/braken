# KITWALLACE | [
# KITWALLACE |   "Hilbert",
# KITWALLACE |   "X",
# KITWALLACE |   [
# KITWALLACE |     [
# KITWALLACE |       "X",
# KITWALLACE |       "-YF+XFX+FY-"
# KITWALLACE |     ],
