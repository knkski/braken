#
# Original Paul Bourke L-system manual/catalog:
# BOURKE | axiom = X
# BOURKE | X -> -YF+XFX+FY-
# BOURKE | Y -> +XF-YFY-FX+
# BOURKE | angle = 90
#
let ANGLE = 90;

axiom X;

match X then Minus Y F Plus X F X Plus F Y Minus;
match Y then Plus X F Minus Y F Y Minus F X Plus;
