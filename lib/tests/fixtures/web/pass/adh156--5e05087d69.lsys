# Execute  : pass; engine=bounded-python-context-free; iterations=5
# Render   : pass; file=../renders/adh156--5e05087d69.svg
# Fidelity : equivalent
# Features : context-free, delayed-expansion, deterministic, fractint-turtle, parametric
# Angle    : 10
# Heading  : 0
# Draw     : F D
# Move     : G M
