# RESETIUS | Grass6 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom +++x
# RESETIUS |   x=+<1F[+X]-<5F[-X]+<10F[+X]-F>1[+X]+F>5[-X]-F>10[+X]
# RESETIUS |   f=<10F<10F>10F>10
# RESETIUS | }
#
let ANGLE = 24;

axiom Plus Plus Plus X;

match X then Plus ColorIncrement(1) F [ Plus X ] Minus ColorIncrement(5) F [ Minus X ] Plus ColorIncrement(10) F [ Plus X ] Minus F ColorIncrement(-1) [ Plus X ] Plus F ColorIncrement(-5) [ Minus X ] Minus F ColorIncrement(-10) [ Plus X ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
