let ANGLE = 30;

axiom T A;

match T then f(1.8) T;
match A then PitchUp(90) X B B B B B B;
match B then Plus(10) X Plus(10) X Plus(10) X;
match X then Z Plus(10) Z Plus(10) Z Plus(10) Z;
match Z then SetWidth(1) R;
match R weight 1 then [ PitchUp(15) f R ];
