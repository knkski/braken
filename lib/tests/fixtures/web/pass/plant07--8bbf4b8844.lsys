let ANGLE = 15.652173913;

axiom X;

match X then ColorIncrement(5) F [ Plus X ] ColorIncrement(5) F [ Minus X ] F ColorIncrement(-5) [ Plus X ] F ColorIncrement(-5) [ Minus X ];
match F then ColorIncrement(10) F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
