let ANGLE = 45;

axiom X;

match X then X Plus F Plus Y Plus F Plus X Minus F Minus Y Minus F Minus X Minus F Minus Y Plus F Plus X Minus F Minus Y Plus F Plus X Plus F Plus Y;
match Y then X Minus F Minus Y Minus F Minus X Plus F Plus Y Minus F Minus X Plus F Plus Y Plus F Plus X Plus F Plus Y Minus F Minus X Minus F Minus Y;
