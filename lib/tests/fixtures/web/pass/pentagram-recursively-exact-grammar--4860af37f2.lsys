let ANGLE = 144;
let SCALE = 2.62;

axiom F A F A F A F A F B;

match A then Minus ScaleLengthInverse A F A F A F A F A F ScaleLength;
match B then Minus ScaleLengthInverse A F A F A F A F A F ScaleLength;
