#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Seaweed03 { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom f
# RESETIUS |   x=--<5Fy[X]++Fy>5[X]
# RESETIUS |   y=++<5Fx[y]--Fx>5[y]
# RESETIUS |   f=<10F[X][y]F>10
# RESETIUS |   }
#
let ANGLE = 12;

axiom F;

match X then Minus Minus ColorIncrement(5) F Y [ X ] Plus Plus F Y ColorIncrement(-5) [ X ];
match Y then Plus Plus ColorIncrement(5) F X [ Y ] Minus Minus F X ColorIncrement(-5) [ Y ];
match F then ColorIncrement(10) F [ X ] [ Y ] F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
