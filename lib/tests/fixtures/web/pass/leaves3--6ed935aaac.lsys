# RESETIUS | Leaves3 { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom x
# RESETIUS |   x=+<5F[++X][---X]-<5F[++X][---X]-<5@.9326F[++X][---X]
# RESETIUS |   x=-@.8557F>5[++X][---X]-@.7788F>5[+X][--X]-@.7019F>5[X]
# RESETIUS |   f=<10F<10F>10F>10
# RESETIUS |   }
#
let ANGLE = 12;

axiom X;

match X then Plus ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus Minus X ] Minus ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus Minus X ] Minus ColorIncrement(5) Scale(0.9326) F [ Plus Plus X ] [ Minus Minus Minus X ] Minus Scale(0.8557) F ColorIncrement(-5) [ Plus Plus X ] [ Minus Minus Minus X ] Minus Scale(0.7788) F ColorIncrement(-5) [ Plus X ] [ Minus Minus X ] Minus Scale(0.7019) F ColorIncrement(-5) [ X ];
match F then ColorIncrement(10) F ColorIncrement(10) F ColorIncrement(-10) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
