let ANGLE = 36;

axiom R;

match R then X;
match X then Minus Minus F Z Plus Plus Plus Plus F W Minus Minus F O;
match Y then Plus F Q Minus Minus F S Plus;
match Z then Plus Plus F X Minus Minus Minus Minus F Y Plus Plus F N;
match W then Minus F T Plus Plus F P Minus;
match U then F Q Minus Minus F S Plus Plus Plus Plus F V Minus Minus;
match V then F T Plus Plus F P Minus Minus Minus Minus F U Plus Plus;
match T then Plus F Q Minus Minus F S Plus Plus Plus Plus F V TurnAround G Plus Plus;
match S then Minus F Y Plus Plus F N Minus;
match Q then Minus F T Plus Plus F P Minus Minus Minus Minus F U TurnAround G Minus Minus;
match P then Plus F W Minus Minus F O Plus;
match O then Minus Minus G TurnAround F X Minus Minus Minus Minus F Y Plus Plus F N Minus;
match N then Plus Plus G TurnAround F Z Plus Plus Plus Plus F W Minus Minus F O Plus;
match F then nothing;
match G then Plus G Minus Minus G Plus;
