#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1bd { ;
# RESETIUS |   Angle 30
# RESETIUS |   Axiom +++X
# RESETIUS |   X=-<3F-<4F[+X][-X]-<5F[+X][-X]-F>5[+X][-X]+F>4[+X][-X]+F>3[+X][-X]
# RESETIUS |   F=<5F<5F>5F>5
# RESETIUS |   }
#
let ANGLE = 12;

axiom Plus Plus Plus X;

match X then Minus ColorIncrement(3) F Minus ColorIncrement(4) F [ Plus X ] [ Minus X ] Minus ColorIncrement(5) F [ Plus X ] [ Minus X ] Minus F ColorIncrement(-5) [ Plus X ] [ Minus X ] Plus F ColorIncrement(-4) [ Plus X ] [ Minus X ] Plus F ColorIncrement(-3) [ Plus X ] [ Minus X ];
match F then ColorIncrement(5) F ColorIncrement(5) F ColorIncrement(-5) F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
