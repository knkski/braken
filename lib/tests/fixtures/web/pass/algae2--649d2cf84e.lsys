let ANGLE = 12;

axiom a F;

match a then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f b;
match b then Plus F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f c;
match c then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f d;
match d then Minus F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f e;
match e then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f g;
match g then F F F F F y [ Plus Plus Plus f a ] f h;
match h then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f i;
match i then Plus F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f j;
match j then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f k;
match k then Minus F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f l;
match l then F F F F F y [ Plus Plus Plus Plus n ] [ Minus Minus Minus Minus t ] f m;
match m then F F F F F y [ Minus Minus Minus f a ] f a;
match n then o f F F F;
match o then f F F F p;
match p then f F F F [ Minus s ] q;
match q then f F F F [ Minus s ] r;
match r then f F F F [ Minus s ];
match s then f F f F;
match t then u f F F F;
match u then f F F F v;
match v then f F F F [ Plus s ] w;
match w then f F F F [ Plus s ] x;
match x then f F F F [ Plus s ];
match y then F y;
