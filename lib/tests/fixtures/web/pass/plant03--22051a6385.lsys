# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Plant03 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom ++FF
# RESETIUS |   F=+<5F[+F]-<5F[-F+F]F>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom Plus Plus F F;

match F then Plus ColorIncrement(5) F [ Plus F ] Minus ColorIncrement(5) F [ Minus F Plus F ] F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
