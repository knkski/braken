let ANGLE = 30;

axiom R;

match R then X;
match X then Minus G Plus [ Plus Plus Plus F ] Plus G Minus X Plus Plus Plus G Plus [ Plus Plus Plus F ] Plus G Minus X Minus Minus Minus Minus Minus G Plus [ Plus Plus Plus F ] Plus G Minus X;
match F then nothing;
match G then nothing;
