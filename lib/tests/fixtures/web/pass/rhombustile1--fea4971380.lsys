let ANGLE = 30;

axiom Y;

match X then Minus F X Plus Plus F X [ Plus Plus Plus Plus F Y ] Minus;
match Y then Plus F Y Minus Minus F Y [ Minus Minus Minus Minus F X ] Plus;
match F then nothing;
