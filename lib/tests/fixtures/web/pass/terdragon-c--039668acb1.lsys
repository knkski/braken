# RESETIUS | Terdragon-c { ; William McWorter
# RESETIUS | ; from Davis and Knuth. Journal of
# RESETIUS | ; Rec. Math. vol. 3, 1970, pages 61-81
# RESETIUS |   Angle 3
# RESETIUS |   Axiom c15F+c48F-c40F
# RESETIUS |   F=F+F-F
# RESETIUS |   }
#
let ANGLE = 120;

axiom Color(15) F Plus Color(48) F Minus Color(40) F;

match F then F Plus F Minus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
