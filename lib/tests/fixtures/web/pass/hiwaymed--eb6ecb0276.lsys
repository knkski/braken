#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Hiwaymed {
# RESETIUS | ; mgl setsize 150 150
# RESETIUS | ; order 10
# RESETIUS |   Angle 8  ; Smallest turn is 45=360/8 degrees
# RESETIUS |   Axiom -X ; Turn whole thing 45 degrees so that all lines of X are horizontal or vertical
# RESETIUS |   X=X+F+Y  ; Do X, turn left, forward, turn left, do Y
# RESETIUS |   Y=X-F-Y  ; Do X backwards
# RESETIUS |   }
#
let ANGLE = 45;

axiom Minus X;

match X then X Plus F Plus Y;
match Y then X Minus F Minus Y;
