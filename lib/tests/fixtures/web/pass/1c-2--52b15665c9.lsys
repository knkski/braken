# RESETIUS | 1c_2 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom X
# RESETIUS |   X=@.9326F[s][t]@.8557F[s][t]@.7788F[s][t]@.7019F[s][t]@.625F[s][t]
# RESETIUS |   s=-<5F[s][t]-<5F[s][t]+<5F[s][t]
# RESETIUS |   s=+F>5[s][t]-F>5[s][t]-F>5[s][t]
# RESETIUS |   t=+<5F[s][t]+<5F[s][t]-<5F[s][t]
# RESETIUS |   t=-F>5[s][t]+F>5[s][t]+F>5[s][t]
# RESETIUS |   F=<10FFFFF>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then Scale(0.9326) F [ S ] [ T ] Scale(0.8557) F [ S ] [ T ] Scale(0.7788) F [ S ] [ T ] Scale(0.7019) F [ S ] [ T ] Scale(0.625) F [ S ] [ T ];
match S then Minus ColorIncrement(5) F [ S ] [ T ] Minus ColorIncrement(5) F [ S ] [ T ] Plus ColorIncrement(5) F [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ];
match T then Plus ColorIncrement(5) F [ S ] [ T ] Plus ColorIncrement(5) F [ S ] [ T ] Minus ColorIncrement(5) F [ S ] [ T ] Minus F ColorIncrement(-5) [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ] Plus F ColorIncrement(-5) [ S ] [ T ];
match F then ColorIncrement(10) F F F F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
