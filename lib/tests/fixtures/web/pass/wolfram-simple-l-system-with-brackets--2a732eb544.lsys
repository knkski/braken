# Fingerprint: sha256:2a732eb54407e57e3c84f331b89a82fc3348bb44e30b0bc92b237dd1c7d91fbd
# Note     : Wolfram LSystem interprets every non-control symbol as draw-forward; the exact drawing alphabet here is: A B.
#
# Original Wolfram Function Repository LSystem:
# WOLFRAM-FUNCTION-R | ResourceFunction["LSystem"][{"A" -> "B+[B]", "B" -> "A-B"}, "AAA", 1, 45]
#
let ANGLE = 45;

axiom A A A;

match A then B Plus [ B ];
match B then A Minus B;
