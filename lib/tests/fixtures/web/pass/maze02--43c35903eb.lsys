let ANGLE = 90;

axiom F X;

match X then Plus F Y Plus F Y F X Minus F X Minus F X F Y F X Minus F X F Y Plus F Y Plus F Y F X Minus F X;
match Y then F Y Plus F Y F X Minus F X Minus F X F Y Plus F Y F X F Y Plus F Y Plus F Y F X Minus F X Minus;
match F then nothing;
