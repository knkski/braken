#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | FernSideView { ;
# RESETIUS |   Angle 50
# RESETIUS |   Axiom x
# RESETIUS |   x=-<5F[+++++X][-----X]-<5F[++++X][----X]-<5F[+++X][---X]-<5F[++X][--X]
# RESETIUS |   x=-F>5[+X][-X]-F>5[X]
# RESETIUS |   f=<20F<20F>20F>20
# RESETIUS |   }
#
let ANGLE = 7.2;

axiom X;

match X then Minus ColorIncrement(5) F [ Plus Plus Plus Plus Plus X ] [ Minus Minus Minus Minus Minus X ] Minus ColorIncrement(5) F [ Plus Plus Plus Plus X ] [ Minus Minus Minus Minus X ] Minus ColorIncrement(5) F [ Plus Plus Plus X ] [ Minus Minus Minus X ] Minus ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus X ] Minus F ColorIncrement(-5) [ Plus X ] [ Minus X ] Minus F ColorIncrement(-5) [ X ];
match F then ColorIncrement(20) F ColorIncrement(20) F ColorIncrement(-20) F ColorIncrement(-20);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
