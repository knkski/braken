let ANGLE = 90;

axiom F Plus F Plus F Plus F Plus F Plus F Plus F Plus F;

match D then SourceU0034 SourceU0032 D InvertTurns ExplicitPlus(84) D InvertTurns ExplicitPlus(42) D;
match F then D [ Plus A ] D [ Plus B ];
match A then Plus F Color(1) Minus F ColorIncrement(21) Plus F ColorIncrement(21) F ColorIncrement(21) Minus F ColorIncrement(21) F ColorIncrement(21) F ColorIncrement(21) Plus F ColorIncrement(21) F ColorIncrement(21) F ColorIncrement(21) F ColorIncrement(21) F ColorIncrement(21);
match B then Minus F Color(255) Plus F ColorIncrement(-21) Minus F ColorIncrement(-21) F ColorIncrement(-21) Plus F ColorIncrement(-21) F ColorIncrement(-21) F ColorIncrement(-21) Minus F ColorIncrement(-21) F ColorIncrement(-21) F ColorIncrement(-21) F ColorIncrement(-21) F ColorIncrement(-21);
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
