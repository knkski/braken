# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Doily-c {
# RESETIUS |   Angle 12
# RESETIUS |   Axiom c32f--c36f--c40f--c44f--c48f--c52f ; from Default.map
# RESETIUS |   f=-f[--f--f]++f--f+
# RESETIUS |   }
#
let ANGLE = 30;

axiom Color(32) F Minus Minus Color(36) F Minus Minus Color(40) F Minus Minus Color(44) F Minus Minus Color(48) F Minus Minus Color(52) F;

match F then Minus F [ Minus Minus F Minus Minus F ] Plus Plus F Minus Minus F Plus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
