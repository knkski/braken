# FRACTINT | Losanges {
# FRACTINT |            ;; by Philippe Hurbain
# FRACTINT |            ;; Penrose's rhombuses, generated by decomposition rules
# FRACTINT |            ;; x generate the fat rhombus, y the thin one
# FRACTINT |            ;; Individualization of rhombuses allows easy coloring
# FRACTINT |            ;; 0.618034 is ({5-1)/2
# FRACTINT |   Angle 10
# FRACTINT |   Axiom x
# FRACTINT |   x=@.618034+f[|y]--f[|x][|+@.618034g@i.618034x]---[x]f--[y]f
# FRACTINT |   y=@.618034++[x]f|+f[|y]-[y]f|+f[|x]
# FRACTINT |   f=g
# FRACTINT | }
#
let ANGLE = 36;

axiom X;

match X then Scale(0.618034) Plus F [ TurnAround Y ] Minus Minus F [ TurnAround X ] [ TurnAround Plus Scale(0.618034) G Scale(1.6180339593) X ] Minus Minus Minus [ X ] F Minus Minus [ Y ] F;
match Y then Scale(0.618034) Plus Plus [ X ] F TurnAround Plus F [ TurnAround Y ] Minus [ Y ] F TurnAround Plus F [ TurnAround X ];
match F then G;
