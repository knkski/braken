# Original Fractint 20.04p17 official rule library:
# FRACTINT | Penrose3 { ; by Herb Savage
# FRACTINT | ; based on Martin Gardner's "Penrose Tiles to Trapdoor Ciphers",
# FRACTINT | ; Roger Penrose's rhombuses
# FRACTINT |   Angle 10
# FRACTINT |   Axiom [X]++[X]++[X]++[X]++[X]
# FRACTINT |   W=YF++ZF----XF[-YF----WF]++
# FRACTINT |   X=+YF--ZF[---WF--XF]+
# FRACTINT |   Y=-WF++XF[+++YF++ZF]-
# FRACTINT |   Z=--YF++++WF[+ZF++++XF]--XF
# FRACTINT |   F=
# FRACTINT |   }
#
let ANGLE = 36;

axiom [ X ] Plus Plus [ X ] Plus Plus [ X ] Plus Plus [ X ] Plus Plus [ X ];

match W then Y F Plus Plus Z F Minus Minus Minus Minus X F [ Minus Y F Minus Minus Minus Minus W F ] Plus Plus;
match X then Plus Y F Minus Minus Z F [ Minus Minus Minus W F Minus Minus X F ] Plus;
match Y then Minus W F Plus Plus X F [ Plus Plus Plus Y F Plus Plus Z F ] Minus;
match Z then Minus Minus Y F Plus Plus Plus Plus W F [ Plus Z F Plus Plus Plus Plus X F ] Minus Minus X F;
match F then nothing;
