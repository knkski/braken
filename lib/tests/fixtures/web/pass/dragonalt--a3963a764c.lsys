let ANGLE = 45;

axiom Minus Color(32) X Plus [ Plus Plus Plus Scale(0.5) G W Minus Minus Minus Color(40) Scale(1.41421356237) F Z ] Plus Color(48) Y;

match F then nothing;
match G then nothing;
match X then F X Plus [ Plus Plus Plus Scale(0.5) G W Minus Minus Minus Color(40) Scale(1.41421356237) F Z ] Plus F Y;
match Y then F X Minus [ Minus Minus Minus Scale(0.5) G W Plus Plus Plus Color(40) Scale(1.41421356237) F Z ] Minus F Y;
match Z then F Z;
match W then G W;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
