# RESETIUS | Plant05 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom +++++X
# RESETIUS |   X=-<5F[-X]+<10F[+X]-F>5[-X]-F>10[-X]
# RESETIUS |   F=<5F<10F>5F>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom Plus Plus Plus Plus Plus X;

match X then Minus ColorIncrement(5) F [ Minus X ] Plus ColorIncrement(10) F [ Plus X ] Minus F ColorIncrement(-5) [ Minus X ] Minus F ColorIncrement(-10) [ Minus X ];
match F then ColorIncrement(5) F ColorIncrement(10) F ColorIncrement(-5) F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
