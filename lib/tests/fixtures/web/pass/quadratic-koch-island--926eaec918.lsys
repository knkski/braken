# ELM | quadraticKochIsland3 =
# ELM |     { default
# ELM |         | rules =
# ELM |             [ ( 'X', "X+YF++YF-FX--FXFX-YF+X" )
# ELM |             , ( 'Y', "-FX+YFYF++YF+FX--FX-YF" )
