let ANGLE = 45;

axiom X Plus X Plus X Plus X Plus X Plus X Plus X Plus X;

match X then X Plus Y F Plus Plus Y F Minus F X Minus Minus F X F X Minus Y F Plus X;
match Y then Minus F X Plus Y F Y F Plus Plus Y F Plus F X Minus Minus F X Minus Y F;
