#
# Original Paul Bourke L-system manual/catalog:
# BOURKE | axiom = X+X+X+X+X+X+X+X
# BOURKE | X -> X+YF++YF-FX--FXFX-YF+X
# BOURKE | Y -> -FX+YFYF++YF+FX--FX-YF
# BOURKE | angle = 45
