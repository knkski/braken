let ANGLE = 12;

axiom X;

match F then Minus Minus ColorIncrement(5) F [ X ] [ Minus Minus Minus Minus X ] Plus Plus F ColorIncrement(-5) [ X ] [ Minus Minus Minus Minus X ];
match X then Plus Plus ColorIncrement(5) F [ Plus Plus Plus Plus F ] [ F ] Minus Minus F ColorIncrement(-5) [ Plus Plus Plus Plus F ] [ F ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
