# RESETIUS | PlantsByRoad { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom x
# RESETIUS |   x=+<18F[+x][-x]-F>18[+x][-x]
# RESETIUS |   f=<10ff>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then Plus ColorIncrement(18) F [ Plus X ] [ Minus X ] Minus F ColorIncrement(-18) [ Plus X ] [ Minus X ];
match F then ColorIncrement(10) F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
