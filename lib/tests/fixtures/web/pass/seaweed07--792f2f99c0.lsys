let ANGLE = 32.7272727273;

axiom F;

match F then Minus ColorIncrement(10) F [ Minus X ] Plus F F ColorIncrement(-10) [ Plus X ];
match X then ColorIncrement(10) F [ Plus F ] ColorIncrement(10) F [ Minus F ] F ColorIncrement(-10) [ Plus F ] F ColorIncrement(-10) [ Minus F ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
