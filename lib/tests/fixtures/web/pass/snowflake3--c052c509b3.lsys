let ANGLE = 30;

axiom F X;

match X then Plus Plus F InvertTurns X InvertTurns F Y Minus Minus F X Minus Minus F Y TurnAround Plus Scale(0.57735026919) F Y F InvertTurns X InvertTurns Plus Plus F InvertTurns Y InvertTurns Plus Plus F InvertTurns Y InvertTurns F X Scale(1.73205080757) Plus Plus Plus F InvertTurns Y InvertTurns F X;
match Y then F Y F InvertTurns X InvertTurns Plus Plus Plus Scale(0.57735026919) F Y F InvertTurns X InvertTurns Plus Plus F InvertTurns X InvertTurns Plus Plus F InvertTurns Y InvertTurns F X Scale(1.73205080757) TurnAround Plus F X Minus Minus F Y Minus Minus F X F InvertTurns Y InvertTurns Plus Plus;
match F then nothing;
