# RESETIUS | ADH156_kavichka_2 { ; Anthony Hanmer 2000
# RESETIUS |   Angle 36 ; Cesaro variation alphabet:  " (closing, 99)
# RESETIUS |   Axiom \60dd\30d\90c000dd\90c015d/30dd
# RESETIUS |   d=d\80d/160d\80d
# RESETIUS |   }
