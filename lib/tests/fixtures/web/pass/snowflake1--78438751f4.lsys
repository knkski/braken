let ANGLE = 30;

axiom F R;

match R then Plus Plus InvertTurns F R F U Plus Plus F U Plus Plus F U InvertTurns Minus Minus Minus Scale(1.73205080757) F U TurnAround Minus Scale(0.57735026919) InvertTurns F R F U InvertTurns;
match U then InvertTurns F R F U InvertTurns TurnAround Plus Scale(1.73205080757) F R Scale(0.57735026919) Plus Plus Plus InvertTurns F R Minus Minus F R Minus Minus F R F U InvertTurns Minus Minus;
match F then nothing;
