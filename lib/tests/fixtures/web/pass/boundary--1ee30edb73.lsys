let ANGLE = 90;

axiom O T U Z;

match F then nothing;
match O then F O Plus F Minus T;
match P then Plus Plus F Minus Minus U Plus F Minus X;
match Q then Minus F Plus V Plus Plus F Minus Minus Q;
match R then Minus F Plus Z F S;
match S then F W;
match T then Plus Plus F Minus Minus U;
match U then Plus Plus F Minus Minus Y;
match V then F S;
match W then F O Plus F Minus P;
match X then Plus Plus F Minus Minus Y Plus F Minus X;
match Y then Minus F Plus R Plus Plus F Minus Minus Q;
match Z then Minus F Plus Z F W;
