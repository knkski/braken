let ANGLE = 60;

axiom Color(31) F X Minus F X Minus F X Minus F X Minus F X Minus F X Minus;

match F then nothing;
match X then F X Minus F X F Y Plus Plus F Z F X Minus F X;
match Y then Minus ColorIncrement(-2) F X Minus F X F Y Plus Plus F Z F X F Y Plus Plus F Z F X Minus F X ColorIncrement(2) Minus;
match Z then Minus Minus ColorIncrement(-2) F X F Y Plus Plus F Z F X F Y Plus Plus F Z F X Minus F X ColorIncrement(2) Minus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
