# RESETIUS | 
# RESETIUS |     angle 6
# RESETIUS |     axiom C31FX-FX-FX-FX-FX-FX-
# RESETIUS | 
# RESETIUS |     F=
# RESETIUS |     X=FX-FXFY++FZFX-FX
# RESETIUS |     Y=->2FX-FXFY++FZFXFY++FZFX-FX<2-
# RESETIUS |     Z=-->2FXFY++FZFXFY++FZFX-FX<2-
# RESETIUS |   }
