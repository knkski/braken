let ANGLE = 30;

axiom T;

match F then F F;
match L then [ Color(48) S Plus F Minus F Minus F Plus TurnAround Plus F Minus F Minus F ];
match R then F [ Minus Minus L ] [ Plus Plus L ] F;
match T then R Plus [ T ] Minus Minus [ Minus Minus L ] R [ Plus Plus L ] Minus [ T ] Plus Plus T;
match S then Scale(0.5) S;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
