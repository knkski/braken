let ANGLE = 90;

axiom X Y X Y X Y X Plus X Y X Y X Y X Plus X Y X Y X Y X Plus X Y X Y X Y X;

match F then nothing;
match X then F X Plus F X Plus F X F Y Minus F Y Minus;
match Y then Plus F X Plus F X F Y Minus F Y Minus F Y;
