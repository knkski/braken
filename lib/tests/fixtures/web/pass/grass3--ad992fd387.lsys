let ANGLE = 24;

axiom Plus Plus Plus Plus Plus Plus Plus X;

match X then ColorIncrement(5) F ColorIncrement(5) F [ Minus X ] Plus ColorIncrement(5) F [ Plus X ] Minus F ColorIncrement(-5) [ Minus X ] Plus F ColorIncrement(-5) [ Plus X ] Minus F ColorIncrement(-5) [ Minus X ];
match F then ColorIncrement(5) F ColorIncrement(5) F F ColorIncrement(-5) F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
