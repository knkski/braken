let ANGLE = 36;

axiom W;

match F then nothing;
match W then Plus Plus F X Minus Minus F W Minus Minus F Y Plus Plus;
match X then Minus F Z Plus Plus F Y Minus;
match Y then Minus Minus F Z Plus Plus F Y Plus Plus F W Minus Minus;
match Z then Plus F X Minus Minus F W Plus;
