let ANGLE = 36;

axiom Color(16) [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus;

match A then Plus F [ Scale(0.236068) I ] Plus Plus [ Scale(0.381966) E ] F;
match B then [ A ] G [ Scale(0.618034) B ] Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus [ A ] G Plus Plus;
match E then ColorIncrement(3) A;
match I then ColorIncrement(3) B;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
