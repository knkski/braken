let ANGLE = 45;

axiom F X Y Plus Plus F Plus Plus F X Y Plus Plus F;

match X then X Y Scale(1.41421356237) Minus F Scale(0.707106781187) Minus F X Y Plus Plus F Plus Plus F X Y;
match Y then Minus Scale(1.41421356237) F Minus Scale(0.707106781187) F X Y;
