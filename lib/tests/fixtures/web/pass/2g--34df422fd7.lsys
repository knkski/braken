#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 2g { ;
# RESETIUS |   Angle 30     ;
# RESETIUS |   Axiom ++++++x
# RESETIUS |   x=+<5F[---X]+<5F[++X][---X]-<5F[++X][---X]
# RESETIUS |   x=-F>5[++X][---X]+F>5[++X][---X]+F>5[++X][---X]
# RESETIUS |   f=<5F<5FF>5F>5
# RESETIUS |   }
#
let ANGLE = 12;

axiom Plus Plus Plus Plus Plus Plus X;

match X then Plus ColorIncrement(5) F [ Minus Minus Minus X ] Plus ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus Minus X ] Minus ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus Minus X ] Minus F ColorIncrement(-5) [ Plus Plus X ] [ Minus Minus Minus X ] Plus F ColorIncrement(-5) [ Plus Plus X ] [ Minus Minus Minus X ] Plus F ColorIncrement(-5) [ Plus Plus X ] [ Minus Minus Minus X ];
match F then ColorIncrement(5) F ColorIncrement(5) F F ColorIncrement(-5) F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
