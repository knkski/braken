# Formalism: Fractint-style context-free turtle string
# Parse    : pass; validator=corpus-static
# Execute  : pass; engine=bounded-python-context-free; iterations=2
# Render   : pass; file=../renders/2g--34df422fd7.svg
# Fidelity : equivalent
