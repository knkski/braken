let ANGLE = 90;

axiom S U;

match F then nothing;
match G then nothing;
match S then F S Plus G Minus X;
match T then Plus Plus F Minus Minus U Plus G Minus X;
match U then Plus Plus F Minus Minus U Minus G Plus Z;
match V then F S Minus G Plus Z;
match W then G W Plus F Minus T;
match X then Plus Plus G Minus Minus Y Plus F Minus T;
match Y then Plus Plus G Minus Minus Y Minus F Plus V;
match Z then G W Minus F Plus V;
