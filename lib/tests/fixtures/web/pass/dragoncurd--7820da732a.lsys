# RESETIUS | DragonCurd {
# RESETIUS |   Angle 4
# RESETIUS |   Axiom su
# RESETIUS |   f=
# RESETIUS |   g=
# RESETIUS |   s=fs+g-x
# RESETIUS |   t=++f--u+g-x
# RESETIUS |   u=++f--u-g+z
# RESETIUS |   v=fs-g+z
