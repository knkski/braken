let ANGLE = 22.5;

axiom X Plus Plus X Plus Plus X Plus Plus X Plus Plus TurnAround G TurnAround X Plus Plus X Plus Plus X Plus Plus X;

match X then [ Color(12) F X Plus Plus Plus Plus Plus Scale(0.7653668647) Color(10) F Scale(1.30656296493) [ Minus Minus Minus Minus Minus Y ] Plus Plus Plus Plus Plus Color(12) F ];
match Y then [ Color(12) F Plus Plus Plus Plus Plus Scale(0.7653668647) Color(10) F Scale(1.30656296493) [ Minus Minus Minus Minus Minus Y ] Plus Plus Plus Plus Plus Color(12) F ];
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
