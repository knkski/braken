#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1b { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom X
# RESETIUS |   X=-<2F-<2F[-X]-<2F[-X]+F>2[-X]+F>2[-X]+F>2[-X]
# RESETIUS |   F=<5F<5F>5F>5
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then Minus ColorIncrement(2) F Minus ColorIncrement(2) F [ Minus X ] Minus ColorIncrement(2) F [ Minus X ] Plus F ColorIncrement(-2) [ Minus X ] Plus F ColorIncrement(-2) [ Minus X ] Plus F ColorIncrement(-2) [ Minus X ];
match F then ColorIncrement(5) F ColorIncrement(5) F ColorIncrement(-5) F ColorIncrement(-5);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
