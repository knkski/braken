let ANGLE = 36;

axiom W G Plus X G Plus W G Plus X G Plus W G Plus X G Plus W G Plus X G Plus W G Plus X;

match W then [ F ] [ Plus Plus Scale(1.618033989) F ] [ Plus Plus G Minus Minus Minus Scale(0.618033989) G TurnAround X Minus Y TurnAround G TurnAround W ];
match X then [ F Plus Plus Plus Scale(1.618033989) F ] [ Plus Plus Scale(0.618033989) G Z TurnAround X TurnAround Minus G TurnAround W ];
match Y then [ Plus F ] [ Scale(1.618033989) F ] [ Plus G Scale(0.618033989) TurnAround Y Plus X ];
match Z then [ Minus F ] [ Scale(1.618033989) F ] [ Scale(0.618033989) G Minus Minus W G TurnAround Plus Z ];
match F then nothing;
