let ANGLE = 7.2;

axiom X;

match X then Scale(0.95) F [ S ] [ T ];
match S then Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F F Minus ColorIncrement(2) F F F [ S ] [ T ] Minus ColorIncrement(2) F [ S ] [ T ] F [ S ] [ T ] F [ S ] [ T ] F [ S ] [ T ] F ColorIncrement(-2) [ S ] [ T ] Minus Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] ColorIncrement(-2) Minus Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] ColorIncrement(-2) Minus Scale(0.95) F [ S ] [ T ];
match T then Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F F Plus ColorIncrement(2) F F F [ S ] [ T ] Plus ColorIncrement(2) F [ S ] [ T ] F [ S ] [ T ] F [ S ] [ T ] F [ S ] [ T ] F ColorIncrement(-2) [ S ] [ T ] Plus Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] ColorIncrement(-2) Plus Scale(0.95) F [ S ] [ T ] Scale(0.95) F [ S ] [ T ] ColorIncrement(-2) Plus Scale(0.95) F [ S ] [ T ];
match F then F F F F F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
