let ANGLE = 30;

axiom Color(31) Z Plus [ A ] Minus Minus F [ A ] Minus Minus F [ A ] Minus Minus F [ A ] Minus Minus F [ A ] Minus Minus F [ A ] Minus Minus F Minus;

match A then ColorIncrement(-2) Plus F [ R ] Minus Minus F [ U ] Minus Minus F [ E ] Minus Minus F;
match E then Plus F [ H ] Minus Minus [ TurnAround InvertTurns H ] F;
match F then Minus InvertTurns F InvertTurns Plus Plus InvertTurns F InvertTurns Minus;
match H then ColorIncrement(-1) Plus F [ I ] Minus Minus [ TurnAround InvertTurns I ] F;
match I then ColorIncrement(-2) Plus F [ J ] Minus Minus [ TurnAround InvertTurns J ] F;
match J then ColorIncrement(-1) Plus F [ K ] Minus Minus [ TurnAround InvertTurns K ] F;
match K then ColorIncrement(-2) Plus F [ L ] Minus Minus [ TurnAround InvertTurns L ] F;
match L then ColorIncrement(-2) Plus F Minus Minus F;
match R then ColorIncrement(-1) Plus F [ S ] Minus Minus F [ U ] Minus Minus F [ E ] Minus Minus F;
match S then ColorIncrement(-2) Plus F [ T ] Minus Minus F [ U ] Minus Minus F [ E ] Minus Minus F;
match T then ColorIncrement(-1) Plus F [ P ] Minus Minus F [ S ] Minus Minus F [ E ] Minus Minus F;
match P then ColorIncrement(-2) Plus F Minus Minus [ TurnAround InvertTurns E ] F Minus Minus F [ E ] Minus Minus F;
match U then ColorIncrement(-2) Plus F [ R ] Minus Minus F [ V ] Minus Minus F Minus Minus F;
match V then ColorIncrement(-1) Plus F [ R ] Minus Minus F [ W ] Minus Minus F [ E ] Minus Minus F;
match W then ColorIncrement(-1) Plus F [ V ] Minus Minus F [ X ] Minus Minus F Minus Minus F;
match X then ColorIncrement(-2) Plus F [ Y ] Minus Minus F [ Y ] Minus Minus F Minus Minus F;
match Y then ColorIncrement(-2) Plus F Minus Minus F Minus Minus F Minus Minus F;
match Z then Z Scale(0.57735026919);
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
