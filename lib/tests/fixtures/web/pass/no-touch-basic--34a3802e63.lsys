#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | No.Touch.Basic {
# RESETIUS | 
# RESETIUS |   ; best order 14
# RESETIUS |   ; time 0:14
# RESETIUS | 
# RESETIUS |     angle 10
# RESETIUS |     axiom C38+[A]FX++[A]FX++[A]FX++[A]FX++[A]FX++
# RESETIUS | 
# RESETIUS |     A=<1+G[@.236068-I]++@.381966E
# RESETIUS |     B=[A]FX[@.618034-B]++[A]FX++[A]FX++[A]FX++[A]FX
# RESETIUS |     E=A
# RESETIUS |     I=B
# RESETIUS |     F=
# RESETIUS |     X=FY
# RESETIUS |     Y=FW
# RESETIUS |     W=G
# RESETIUS |   }
#
let ANGLE = 36;

axiom Color(38) Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus;

match A then ColorIncrement(1) Plus G [ Scale(0.236068) Minus I ] Plus Plus Scale(0.381966) E;
match B then [ A ] F X [ Scale(0.618034) Minus B ] Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X Plus Plus [ A ] F X;
match E then A;
match I then B;
match F then nothing;
match X then F Y;
match Y then F W;
match W then G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
