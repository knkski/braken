#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Seaweed02 { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom f
# RESETIUS |   x=--<5F[X]++F>5[X]
# RESETIUS |   y=++<5F[y]--F>5[y]
# RESETIUS |   f=<10F[X][y]F>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom F;

match X then Minus Minus ColorIncrement(5) F [ X ] Plus Plus F ColorIncrement(-5) [ X ];
match Y then Plus Plus ColorIncrement(5) F [ Y ] Minus Minus F ColorIncrement(-5) [ Y ];
match F then ColorIncrement(10) F [ X ] [ Y ] F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
