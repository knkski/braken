let ANGLE = 15;

axiom X;

match F then F X [ F X [ Plus X F ] ];
match X then F F [ Plus X HalfForward Plus Plus X Minus F [ Plus HalfForward X ] ] [ Minus X Plus Plus F Minus X ];
match Z then [ Plus F Minus X Minus F ] [ Plus Plus HalfForward X ];
