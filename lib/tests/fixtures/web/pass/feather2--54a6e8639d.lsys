let ANGLE = 24;

axiom TurnAround F;

match F then Minus ColorIncrement(10) F [ Plus X ] Plus F ColorIncrement(-10) [ Minus S ];
match X then Plus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1);
match S then Plus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus ColorIncrement(1) F Plus ColorIncrement(1) F Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1) Minus F ColorIncrement(-1) Plus F ColorIncrement(-1);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
