let ANGLE = 36;

axiom D Minus Minus Minus Minus B Minus C Minus Minus Minus Minus A;

match A then C Plus Plus D Minus Minus Minus Minus B [ Minus C Minus Minus Minus Minus A ] Plus Plus;
match B then Plus C Minus Minus D [ Minus Minus Minus A Minus Minus B ] Plus;
match C then Minus A Plus Plus B [ Plus Plus Plus C Plus Plus D ] Minus;
match D then Minus Minus C Plus Plus Plus Plus A [ Plus D Plus Plus Plus Plus B ] Minus Minus B;
