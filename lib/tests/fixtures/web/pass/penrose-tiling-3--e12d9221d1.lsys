# JKUBIN | AXIOM(⟦PENROSE⟧, ⟦D----B-C----A⟧)
# JKUBIN | RULE(⟦A⟧, ⟦C++D----B[-C----A]++⟧, ⟦F⟧)
# JKUBIN | RULE(⟦B⟧, ⟦+C--D[---A--B]+⟧, ⟦F⟧)
# JKUBIN | RULE(⟦C⟧, ⟦-A++B[+++C++D]-⟧, ⟦F⟧)
