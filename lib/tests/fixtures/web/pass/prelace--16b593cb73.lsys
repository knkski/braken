let ANGLE = 30;

axiom Plus Plus Plus Color(32) F W Minus Minus Minus Minus Color(15) F Z Color(48) F W Plus;

match F then nothing;
match Y then Plus Plus Plus F W Minus Minus Minus Minus F Z F W Plus;
match X then Plus F Z F W Minus Minus Minus Minus F Z Plus Plus Plus;
match W then Minus Minus Minus F Y Plus Plus Plus Plus F X F Y Minus;
match Z then Minus F X F Y Plus Plus Plus Plus F X Minus Minus Minus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
