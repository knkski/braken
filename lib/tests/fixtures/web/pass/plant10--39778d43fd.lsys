let ANGLE = 24;

axiom TurnAround Minus Minus Minus Minus F;

match F then F F [ S ] [ T ] F [ S ] [ T ];
match S then Minus ColorIncrement(5) F F F [ Plus Plus S ] [ Minus T ] ColorIncrement(5) F [ Plus Plus S ] [ Minus T ] Minus ColorIncrement(5) F [ Plus Plus S ] [ Minus T ] F ColorIncrement(-5) [ Plus Plus S ] [ Minus T ] F ColorIncrement(-5) [ Plus Plus S ] [ Minus T ] Minus F ColorIncrement(-5) [ Plus Plus S ] [ Minus S ];
match T then Plus ColorIncrement(5) F F F [ Plus Plus S ] [ Minus T ] ColorIncrement(5) F [ Plus Plus S ] [ Minus T ] Plus ColorIncrement(5) F [ Plus Plus S ] [ Minus T ] F ColorIncrement(-5) [ Plus Plus S ] [ Minus T ] F ColorIncrement(-5) [ Plus Plus S ] [ Minus T ] Plus F ColorIncrement(-5) [ Plus Plus S ] [ Minus T ];
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
