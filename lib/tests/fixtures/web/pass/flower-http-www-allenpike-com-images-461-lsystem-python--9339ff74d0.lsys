let ANGLE = 18;

axiom P;

match P then I Plus [ P Plus O ] Minus Minus RollRight RollRight [ Minus Minus L ] I [ Plus Plus L ] Minus [ P O ] Plus Plus P O;
match I then F S [ RollRight RollRight PitchDown PitchDown L ] [ RollRight RollRight PitchUp PitchUp L ] F S;
match S then [ SourceU0028 TurtleNumber33 ColorPrevious S [ RollRight RollRight PitchDown PitchDown L ] [ RollRight RollRight PitchUp PitchUp L ] F S ColorPrevious SourceU0029 SourceU0028 TurtleNumber33 ColorPrevious S F S ColorPrevious SourceU0029 SourceU0028 TurtleNumber34 ColorPrevious S ColorPrevious SourceU0029 ];
