# RESETIUS | Koch.Levitation {
# RESETIUS | 
# RESETIUS |   ; best order 6
# RESETIUS |   ; time 0:10
# RESETIUS | 
# RESETIUS |     angle 6
# RESETIUS |     axiom C31FW+FW+FW+FW+FW+FW+
# RESETIUS | 
# RESETIUS |     F=
# RESETIUS |     W=-FXFY++FZFX-
# RESETIUS |     X=FX-FXFY++FZFX-FX
# RESETIUS |     Y=->3FX-FXFY++FZFXFY++FZFX-FX-
# RESETIUS |     Z=--FXFY++FZFXFY++FZFX-FX<3-
# RESETIUS |   }
#
let ANGLE = 60;

axiom Color(31) F W Plus F W Plus F W Plus F W Plus F W Plus F W Plus;

match F then nothing;
match W then Minus F X F Y Plus Plus F Z F X Minus;
match X then F X Minus F X F Y Plus Plus F Z F X Minus F X;
match Y then Minus ColorIncrement(-3) F X Minus F X F Y Plus Plus F Z F X F Y Plus Plus F Z F X Minus F X Minus;
match Z then Minus Minus F X F Y Plus Plus F Z F X F Y Plus Plus F Z F X Minus F X ColorIncrement(3) Minus;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
