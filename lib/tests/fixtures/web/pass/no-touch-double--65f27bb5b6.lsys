# RESETIUS | No.Touch.Double {
# RESETIUS | 
# RESETIUS |   ; best order 14
# RESETIUS |   ; time 0:37
# RESETIUS | 
# RESETIUS |     angle 10
# RESETIUS |     axiom C39+[A]FX++[A]FX++[A]FX++[A]FX++[A]FX++
# RESETIUS | 
# RESETIUS |     A=<1+G[@.236068-I]++@.381966E
# RESETIUS |     B=[A]FX[@.618034-H]++[A]FX++[A]FX[@.618034-H]++[A]FX++[A]FX
# RESETIUS |     H=[A]FX[@.618034-H]++[A]FX++[A]FX++[A]FX++[A]FX
# RESETIUS |     E=A
# RESETIUS |     I=B
# RESETIUS |     F=
# RESETIUS |     X=FY
# RESETIUS |     Y=FW
# RESETIUS |     W=G
# RESETIUS |   }
