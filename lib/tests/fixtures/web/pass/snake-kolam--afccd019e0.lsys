let ANGLE = 90;

axiom F Plus X F Plus F Plus X F;

match X then X PolygonBegin F Minus F Minus F PolygonEnd Plus X F Plus F Plus X PolygonBegin F Minus F Minus F PolygonEnd Plus X;
