let ANGLE = 90;

axiom X;

match F then nothing;
match X then F X Minus F Y Minus F X Plus F Y Plus F X Plus F Y Minus F X Minus F Y Plus;
match Y then Minus F X Plus F Y Plus F X Minus F Y Minus F X Minus F Y Plus F X Plus F Y;
