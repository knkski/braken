# RESETIUS | SpacefillingTree {
# RESETIUS |   Angle 6
# RESETIUS |   Axiom r
# RESETIUS |   r=x
# RESETIUS |   x=xf[-f+x]+f+y--
# RESETIUS |   y=xf[+f+x]-f+y
# RESETIUS |   }
#
let ANGLE = 60;

axiom R;

match R then X;
match X then X F [ Minus F Plus X ] Plus F Plus Y Minus Minus;
match Y then X F [ Plus F Plus X ] Minus F Plus Y;
