let ANGLE = 60;

axiom X;

match X then [ Minus F Plus F [ Y ] Plus F ] [ Plus F Minus F [ X ] Minus F ];
match Y then [ Minus F Plus F [ Y ] Plus F ] [ Plus F Minus F Minus F ];
