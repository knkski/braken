# Note     : Wolfram LSystem interprets every non-control symbol as draw-forward; the exact drawing alphabet here is: F X.
#
# Original Wolfram Function Repository LSystem:
# WOLFRAM-FUNCTION-R | ResourceFunction["LSystem"][{"F" -> "FF", "X" -> "--FXF++FXF++FXF--"}, "FXF--FF--FF", 5, 60]
#
let ANGLE = 60;

axiom F X F Minus Minus F F Minus Minus F F;

match F then F F;
match X then Minus Minus F X F Plus Plus F X F Plus Plus F X F Minus Minus;
