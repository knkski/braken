let ANGLE = 30;

axiom Plus S A;

match S then F S;
match A then T [ Minus Minus RollRight RollRight K ] [ Plus Plus RollRight RollRight K ] I RollRight RollRight RollRight A;
match I then F i;
match i then F j;
match j then J [ Minus Minus F F A ] [ Plus Plus F F A ];
