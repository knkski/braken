# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | CesaroDouble { ; Adrian Mariano
# RESETIUS | ; from The Fractal Geometry of Nature by Mandelbrot
# RESETIUS |   Angle 4
# RESETIUS |   axiom D\90D\90D\90D\90
# RESETIUS |   D=\42!D!/84!D!\42
# RESETIUS |   }
#
# Original Fractint 20.04p17 official rule library:
# FRACTINT | DoubleCesaro { ; Adrian Mariano
# FRACTINT | ; from The Fractal Geometry of Nature by Mandelbrot
# FRACTINT |   Angle 4
# FRACTINT |   axiom D\90D\90D\90D\90
# FRACTINT |   D=\42!D!/84!D!\42
# FRACTINT |   }
#
let ANGLE = 90;

axiom D ExplicitPlus(90) D ExplicitPlus(90) D ExplicitPlus(90) D ExplicitPlus(90);

match D then ExplicitPlus(42) InvertTurns D InvertTurns ExplicitMinus(84) InvertTurns D InvertTurns ExplicitPlus(42);
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
