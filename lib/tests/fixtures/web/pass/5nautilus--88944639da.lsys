let ANGLE = 7.65957446809;

axiom X;

match X then X G Plus Scale(0.97) X [ Scale(3.68) A Scale(0.92) B ];
match A then Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus Minus F Minus F Minus F Minus F Minus F Minus Scale(0.5) F ExplicitMinus(120) Plus F Plus F Plus F;
match B then ExplicitPlus(2) Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus Plus F F Plus F F Plus F F Plus F F Plus F F;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
