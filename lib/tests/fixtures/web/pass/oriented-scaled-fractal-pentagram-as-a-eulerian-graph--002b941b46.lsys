let ANGLE = 36;
let SCALE = 2;

axiom F Minus Minus Minus Minus F Minus Minus Minus Minus F Minus Minus Minus Minus F Minus Minus Minus Minus F;

match F then F Plus ScaleLength WidthIncrease F WidthDecrease ScaleLengthInverse Plus F Minus Minus Minus Minus F Minus Minus Minus Minus F Minus Minus Minus Minus F;
