let ANGLE = 24;

axiom F Plus F Plus F Plus F;

match D then SourceU0034 SourceU0032 D InvertTurns ExplicitPlus(84) D InvertTurns ExplicitPlus(42) D;
match F then D InvertTurns [ Plus A ] D [ Plus B ];
match A then F Color(1) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21) Scale(0.9) F ColorIncrement(21);
match B then F Color(255) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21) Scale(0.9) F ColorIncrement(-21);
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
