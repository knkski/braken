let ANGLE = 90;

axiom S;

match F then nothing;
match S then F S Plus F Minus T;
match T then Plus F Minus U Plus F Minus T;
match U then Plus Plus F Minus Minus V Plus Plus F Minus Minus W;
match V then Plus Plus F Minus Minus V Minus F Plus X;
match W then Minus F Plus Y Plus Plus F Minus Minus W;
match X then Minus F Plus Y Minus F Plus X;
match Y then F S F Z;
match Z then Plus F Minus U F Z;
