# RESETIUS | Snow.Flake.2 {
# RESETIUS | 
# RESETIUS |   ; best order 4
# RESETIUS |   ; time 0:11
# RESETIUS | 
# RESETIUS |     angle 6
# RESETIUS |     axiom C19++[F]-[F]-[F]-[F]-[F]-[F]---
# RESETIUS | 
# RESETIUS |     F=F[@I2[--F][-F][+F][++F]]<2F[--F][-F][+F][++F]F>2[@I2[--F][-F][+F][++F]]F
# RESETIUS |   }
#
let ANGLE = 60;

axiom Color(19) Plus Plus [ F ] Minus [ F ] Minus [ F ] Minus [ F ] Minus [ F ] Minus [ F ] Minus Minus Minus;

match F then F [ Scale(0.5) [ Minus Minus F ] [ Minus F ] [ Plus F ] [ Plus Plus F ] ] ColorIncrement(2) F [ Minus Minus F ] [ Minus F ] [ Plus F ] [ Plus Plus F ] F ColorIncrement(-2) [ Scale(0.5) [ Minus Minus F ] [ Minus F ] [ Plus F ] [ Plus Plus F ] ] F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
