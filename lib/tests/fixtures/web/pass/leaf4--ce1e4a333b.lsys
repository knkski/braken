#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf4 {
# RESETIUS | ; order 10
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(0)][-A(0)]FA(0)
# RESETIUS |   F=@2.0F@i2.0
# RESETIUS | }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(0) ] [ Minus A(0) ] F A(0);
match F then Scale(2) F Scale(0.5);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(0) ] [ Minus A(0) ] F A(0);
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
