let ANGLE = 7.2;

axiom X;

match X then ColorIncrement(5) F [ Plus Plus Plus Plus Plus X ] [ Minus Minus Minus Minus Minus X ] ColorIncrement(5) F [ Plus Plus Plus Plus X ] [ Minus Minus Minus Minus X ] ColorIncrement(5) F [ Plus Plus Plus X ] [ Minus Minus Minus X ] ColorIncrement(5) F [ Plus Plus X ] [ Minus Minus X ] F ColorIncrement(-5) [ Plus X ] [ Minus X ] F ColorIncrement(-5) [ X ];
match F then ColorIncrement(20) F ColorIncrement(20) F ColorIncrement(-20) F ColorIncrement(-20);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
