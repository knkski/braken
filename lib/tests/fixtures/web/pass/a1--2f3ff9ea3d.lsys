let ANGLE = 60;

axiom R;

match R then Color(40) F Minus F F Plus F X Plus F P Plus F P ColorIncrement(8) F Minus F F Plus F X Plus F P Plus F P ColorIncrement(8) F Minus F F Plus F X Plus F P Plus F P;
match X then F Minus F F Plus F X Plus F P Plus F P F Minus F F Plus F X F P Minus F P Minus F Minus F F Plus F X;
match P then F P;
match F then nothing;
match G then nothing;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
