let ANGLE = 25;

axiom B(2) A(4,4);

match A(x,y) when y<=3 then A(x*2,x+y);
match A(x,y) when y>3 then B(x) A(x/y,0);
match B(x) when x<1 then C;
match B(x) when x>=1 then B(x-1);
