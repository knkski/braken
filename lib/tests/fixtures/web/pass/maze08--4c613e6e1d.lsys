let ANGLE = 90;

axiom X;

match X then F X Minus F Y Plus F X Minus F Y Plus F X Plus F X Minus F Y Plus F X Plus F X F Y Minus F Y Minus F X Plus F Y Minus;
match Y then Plus F X Minus F Y Plus F X Plus F X F Y Minus F Y Minus F X Plus F Y Minus F Y Minus F X Plus F Y Minus F X Plus F Y;
