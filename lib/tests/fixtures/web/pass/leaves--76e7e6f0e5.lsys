# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaves { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom |x
# RESETIUS |   x=+<1F[+X][-X]+<5F[+X][-X]+<10F[+X][-X]
# RESETIUS |   x=-F>1[+X][-X]-F>5[+X][-X]-F>10[+X][-X]
# RESETIUS |   f=<10FFF>10
# RESETIUS |   }
#
let ANGLE = 24;

axiom TurnAround X;

match X then Plus ColorIncrement(1) F [ Plus X ] [ Minus X ] Plus ColorIncrement(5) F [ Plus X ] [ Minus X ] Plus ColorIncrement(10) F [ Plus X ] [ Minus X ] Minus F ColorIncrement(-1) [ Plus X ] [ Minus X ] Minus F ColorIncrement(-5) [ Plus X ] [ Minus X ] Minus F ColorIncrement(-10) [ Plus X ] [ Minus X ];
match F then ColorIncrement(10) F F F ColorIncrement(-10);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
