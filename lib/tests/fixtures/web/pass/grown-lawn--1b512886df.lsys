let ANGLE = 72;

axiom Color(70) [ ExplicitPlus(63) Scale(0.5) D Scale(2) X ] M [ ExplicitPlus(78) Scale(0.5) D Scale(2) InvertTurns X ] M [ ExplicitPlus(72) D X ] M [ ExplicitPlus(81) D X ] M [ ExplicitPlus(69) Scale(0.5) D Scale(2) X ] M [ ExplicitPlus(90) D InvertTurns X ] M [ ExplicitPlus(90) D X ] M [ ExplicitPlus(108) Scale(0.5) D Scale(2) InvertTurns X ] M [ ExplicitPlus(99) D InvertTurns X ] M [ ExplicitPlus(102) Scale(0.5) D Scale(2) X ] M [ ExplicitPlus(117) Scale(0.5) D Scale(2) X ] M [ ExplicitPlus(135) Scale(0.5) D Scale(2) InvertTurns X ];

match X then D ExplicitMinus(2) [ A ] D ExplicitMinus(2) [ InvertTurns A ] D ExplicitMinus(2) Scale(0.618034) X;
match A then B;
match B then E;
match E then Scale(0.381966) ColorIncrement(-1) X;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
