# Original Fractint 20.04p17 official rule library:
# FRACTINT | Kites&DartsColor {
# FRACTINT |                    ;; by Philippe Hurbain
# FRACTINT |                    ;; Penrose's kites and darts, with serpentine coloring
# FRACTINT |   Angle 10
# FRACTINT |   Axiom c4[k]++[k]++[k]++[k]++[k]
# FRACTINT |   k=+[@.618034a[g---@.618c10f][--g+++@.618c10f]]
# FRACTINT |   k=f@.618034---[-k]f-f---[-k]@i.618034f[@.618034|a]
# FRACTINT |   a=[@.618034k]+f@.618034[|a][|g++@.382c10f]----f+
# FRACTINT |   a=f----[a][g--@.382c10f]@i.618034f
# FRACTINT |   f=g
# FRACTINT | }
#
let ANGLE = 36;

axiom Color(4) [ K ] Plus Plus [ K ] Plus Plus [ K ] Plus Plus [ K ] Plus Plus [ K ];

match K then Plus [ Scale(0.618034) A [ G Minus Minus Minus Scale(0.618) Color(10) F ] [ Minus Minus G Plus Plus Plus Scale(0.618) Color(10) F ] ] F Scale(0.618034) Minus Minus Minus [ Minus K ] F Minus F Minus Minus Minus [ Minus K ] Scale(1.6180339593) F [ Scale(0.618034) TurnAround A ];
match A then [ Scale(0.618034) K ] Plus F Scale(0.618034) [ TurnAround A ] [ TurnAround G Plus Plus Scale(0.382) Color(10) F ] Minus Minus Minus Minus F Plus F Minus Minus Minus Minus [ A ] [ G Minus Minus Scale(0.382) Color(10) F ] Scale(1.6180339593) F;
match F then G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
