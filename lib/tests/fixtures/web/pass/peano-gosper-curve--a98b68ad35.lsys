let ANGLE = 60;

axiom F X;

match X then X Plus Y F Plus Plus Y F Minus F X Minus Minus F X F X Minus Y F Plus;
match Y then Minus F X Plus Y F Y F Plus Plus Y F Plus F X Minus Minus F X Minus Y;
