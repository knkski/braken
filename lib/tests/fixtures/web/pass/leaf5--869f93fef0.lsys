#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | Leaf5 {
# RESETIUS | ; order 16
# RESETIUS |   angle 8
# RESETIUS |   axiom a
# RESETIUS |   a=F[+A(1)][-A(1)]FA(0)
# RESETIUS |   F=@1.5F@i1.5
# RESETIUS | }
#
let ANGLE = 45;

axiom A;

match A then F [ Plus A(1) ] [ Minus A(1) ] F A(0);
match F then Scale(1.5) F Scale(0.666666666667);
match A(delay) when delay > 0 then A(delay - 1);
match A(delay) when delay <= 0 then F [ Plus A(1) ] [ Minus A(1) ] F A(0);
