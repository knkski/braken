let ANGLE = 18;

axiom Color(4) K;

match K then Plus Plus [ Scale(0.618034) [ G Minus Color(10) Scale(0.5878) [ F ] Minus Minus Minus Minus Minus Minus F F Plus Plus Plus Plus F ] A ] F Scale(0.618034) Minus Minus Minus Minus Minus Minus [ Minus Minus K ] F Minus Minus F Minus Minus Minus Minus Minus Minus [ Minus Minus K ] Scale(1.6180339593) F [ Scale(0.618034) TurnAround A ];
match A then [ Scale(0.618034) K ] Plus Plus F Scale(0.618034) [ TurnAround [ G Color(10) Scale(0.5878) Plus Plus Plus Plus Plus Plus Plus F ] A ] Minus Minus Minus Minus Minus Minus Minus Minus F Plus Plus F Minus Minus Minus Minus Minus Minus Minus Minus [ Color(10) G Scale(0.5878) Minus Minus Minus Minus Minus Minus Minus F ] [ A ] Scale(1.6180339593) F;
match F then G;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
