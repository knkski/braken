let ANGLE = 45;

axiom R;

match R then X;
match X then X Minus Scale(1.41421356237) F Scale(0.707106781187) Plus X Minus Scale(1.41421356237) F Scale(0.707106781187) Plus F F Plus Plus F F TurnAround X Minus Minus Y F F F F TurnAround;
match Y then Y Plus Scale(1.41421356237) F Scale(0.707106781187) Minus Y Plus Scale(1.41421356237) F Scale(0.707106781187) Minus F F Minus Minus F F TurnAround Y Plus Plus X F F F F TurnAround;
match F then G G;
match G then G G;
