#
# Original resetius/lsystem Fractint-rule catalog (commit f7fa950):
# RESETIUS | 1d { ;
# RESETIUS |   Angle 15
# RESETIUS |   Axiom x
# RESETIUS |   ;x=-<5F<5F[+++X][-X]-<5F[+++X][-X]+F>5[+++X][-X]-F>5[+++X][-X]+F>5[+++X][-X]
# RESETIUS |   x=-<5F+<5F-F[+++X][-X]+F>5-F>5[+++X][-X]
# RESETIUS |   f=FFF
# RESETIUS |   }
#
let ANGLE = 24;

axiom X;

match X then Minus ColorIncrement(5) F Plus ColorIncrement(5) F Minus F [ Plus Plus Plus X ] [ Minus X ] Plus F ColorIncrement(-5) Minus F ColorIncrement(-5) [ Plus Plus Plus X ] [ Minus X ];
match F then F F F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
