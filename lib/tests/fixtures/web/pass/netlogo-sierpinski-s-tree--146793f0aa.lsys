# Name     : NetLogo Sierpinski's Tree
# Source   : NetLogo L-System Fractals model | NetLogo 7.0.4 code lines 103-117; setup-sierpinski and sierpinski | https://raw.githubusercontent.com/NetLogo/models/46db92708c960b3f10c5d6b3b685c37be1faf79c/Sample%20Models/Mathematics/Fractals/L-System%20Fractals.nlogox
# Formalism: parallel turtle-agent procedural rewriting projected to a parametric bracketed L-system
# Parse    : pass; validator=corpus-static
# Execute  : not-run; target=attached-cpu
# Render   : unsupported; reason=unsupported render profile 'parametric-agent-turtle2d'
# Fidelity : projection
# Features : bracketed, deterministic, parallel-turtle-agents, parametric, spawn, turtle2d
# Angle    : unspecified
# Heading  : 90
# Draw     : Forward
# Move     : Move
# Profile  : parametric-agent-turtle2d
# Fingerprint: sha256:146793f0aa4b6d5b8aae7220b07c2532c8c7dda869f227b5b23a014fa2ccbb6b
# Note     : NetLogo runs one procedure per live turtle per tick. Tip parameters preserve turtle-local length, and [Tip(...)] represents a spawned clone at its spawn pose.
# Note     : Geometry is preserved; NetLogo color inheritance/increment and absolute initial x/y translation are omitted because the target language has no equivalent state channels.
# Note     : NetLogo heading 0 (north) is normalized to Cartesian turtle heading 90 degrees.
# Note     : The model leaves tick count interactive; no source iteration count is asserted.
# Note     : Official model page: https://ccl.northwestern.edu/netlogo/models/L-SystemFractals
# Note     : Source initial point: (0, -25); source initial heading: 0 degrees.
#
# Original NetLogo L-System Fractals model:
# NETLOGO-LSYSTEM-FR | to setup-sierpinski
# NETLOGO-LSYSTEM-FR |   set color-inc 3
# NETLOGO-LSYSTEM-FR |   set init-color 9
# NETLOGO-LSYSTEM-FR |   set init-x 0
# NETLOGO-LSYSTEM-FR |   set init-y -25
# NETLOGO-LSYSTEM-FR |   setup
# NETLOGO-LSYSTEM-FR |   ask turtles [ set len 110 ]
# NETLOGO-LSYSTEM-FR |   set rule-set "sierpinski"
# NETLOGO-LSYSTEM-FR | end
# NETLOGO-LSYSTEM-FR | 
# NETLOGO-LSYSTEM-FR | to sierpinski
# NETLOGO-LSYSTEM-FR |   set len len / 2
# NETLOGO-LSYSTEM-FR |   repeat 3 [ fd len spawn rt 180 skip len rt 300 ]
# NETLOGO-LSYSTEM-FR |   die
# NETLOGO-LSYSTEM-FR | end
#
axiom Tip(110);

match Tip(len) then Forward(len / 2) [ Tip(len / 2) ] ExplicitMinus(180) Move(len / 2) ExplicitMinus(300) Forward(len / 2) [ Tip(len / 2) ] ExplicitMinus(180) Move(len / 2) ExplicitMinus(300) Forward(len / 2) [ Tip(len / 2) ] ExplicitMinus(180) Move(len / 2) ExplicitMinus(300);
