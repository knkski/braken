let ANGLE = 7.2;

axiom X;

match X then F [ S ] [ T ] TurnAround F [ S ] [ T ];
match S then Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F F Minus ColorIncrement(2) F F F [ S ] [ T ] Minus ColorIncrement(2) F F F F F ColorIncrement(-2) [ S ] [ T ] Minus F F F [ S ] [ T ] ColorIncrement(-2) Minus F F [ S ] [ T ] ColorIncrement(-2) Minus F [ S ] [ T ] ColorIncrement(-2) Minus F ColorIncrement(-2);
match T then Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F F Plus ColorIncrement(2) F F F [ S ] [ T ] Plus ColorIncrement(2) F F F F F ColorIncrement(-2) [ S ] [ T ] Plus F F F [ S ] [ T ] ColorIncrement(-2) Plus F F [ S ] [ T ] ColorIncrement(-2) Plus F [ S ] [ T ] ColorIncrement(-2) Plus F [ S ] [ T ] ColorIncrement(-2);
match F then F F F F F;
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
