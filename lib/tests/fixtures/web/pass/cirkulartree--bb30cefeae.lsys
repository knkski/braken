# RESETIUS |   F=F[+s]F[-t]
# RESETIUS |   S=+<2F-<2F-<2F+<2F+<2F+<2F-<2F-<2F-<2F
# RESETIUS |   S=-<2F-F>2+F>2+F>2+F>2+F>2+F>2+F>2+F>2+F>2
# RESETIUS |   T=-<2F+<2F+<2F-<2F-<2F-<2F+<2F+<2F+<2F
