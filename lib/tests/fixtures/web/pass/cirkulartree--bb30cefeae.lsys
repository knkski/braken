let ANGLE = 36;

axiom F;

match F then F [ Plus S ] F [ Minus T ];
match S then Plus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2) Plus F ColorIncrement(-2);
match T then Minus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Minus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus ColorIncrement(2) F Plus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2) Minus F ColorIncrement(-2);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
