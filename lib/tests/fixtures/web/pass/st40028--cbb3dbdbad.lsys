let ANGLE = 90;

axiom Color(9) F Plus Color(10) F Plus Color(12) F Plus Color(14) F;

match F then F Plus F F Minus F Minus F F Plus F Plus F F Minus F;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
