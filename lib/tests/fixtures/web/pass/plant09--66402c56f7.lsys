# RESETIUS |   Angle 30
# RESETIUS |   Axiom F+F+F
# RESETIUS |   F=F[X]
# RESETIUS |   X=FSFT
# RESETIUS |   S=+F[+X]-F[-X]
# RESETIUS |   T=-F[-X]+F[+X]
# RESETIUS |   }
#
let ANGLE = 12;

axiom F Plus F Plus F;

match F then F [ X ];
match X then F S F T;
match S then Plus F [ Plus X ] Minus F [ Minus X ];
match T then Minus F [ Minus X ] Plus F [ Plus X ];
