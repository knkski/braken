let ANGLE = 12;

axiom F Color(1) Plus F Plus F Plus F Plus F Plus F Plus F Color(51) Plus F Plus F Plus F Plus F Plus F Plus F Color(102) Plus F Plus F Plus F Plus F Plus F Plus F Color(68) Plus F Plus F Plus F Plus F Plus F Plus F Color(34) Plus F Plus F Plus F Plus F Plus F;

match F then F [ X ];
match X then F S F T;
match S then Minus F Color(1) [ Plus X ] Minus F Color(128) [ Minus X ];
match T then Plus F Color(196) [ Minus X ] Plus F Color(64) [ Plus X ];
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
