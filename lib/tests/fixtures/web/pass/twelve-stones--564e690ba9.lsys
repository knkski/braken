let ANGLE = 72;

axiom Color(31) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30) A ExplicitPlus(30);

match A then [ Scale(0.5) X ] [ Y ] Scale(0.5) D Scale(2);
match X then ExplicitPlus(5) ColorIncrement(-1) [ D ] W;
match W then ExplicitPlus(5) [ D ] X;
match Y then ExplicitMinus(5) ColorIncrement(-1) [ D ] Z;
match Z then ExplicitMinus(5) [ D ] Y;
match Color(delay) when delay > 0 then Color(delay - 1);
match Color(delay) when delay <= 0 then Color;
match ExplicitMinus(delay) when delay > 0 then ExplicitMinus(delay - 1);
match ExplicitMinus(delay) when delay <= 0 then ExplicitMinus;
match ExplicitPlus(delay) when delay > 0 then ExplicitPlus(delay - 1);
match ExplicitPlus(delay) when delay <= 0 then ExplicitPlus;
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
