let ANGLE = 30;

axiom F;

match F then Minus Minus InvertTurns F ColorIncrement(1) InvertTurns F ColorIncrement(1) Plus Plus F ColorIncrement(1) Plus Plus F ColorIncrement(1) Scale(0.57735026919) TurnAround Minus F ColorIncrement(1) InvertTurns F ColorIncrement(1) Plus Plus F ColorIncrement(1) Plus Plus F ColorIncrement(1) InvertTurns Minus Minus Minus Scale(1.73205080757) F ColorIncrement(1) Scale(0.57735026919) TurnAround Minus F ColorIncrement(1) InvertTurns F ColorIncrement(1) Scale(1.73205080757) TurnAround Minus F ColorIncrement(1) InvertTurns F ColorIncrement(1);
match ColorIncrement(delay) when delay > 0 then ColorIncrement(delay - 1);
match ColorIncrement(delay) when delay <= 0 then ColorIncrement;
