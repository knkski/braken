let ANGLE = 90;

axiom F Plus F Plus F Plus F;

match F then F Plus G F Minus F F Minus F Minus F F Plus G Plus F F Minus G F Plus F F Plus F Plus F F Minus G Minus F F F;
match G then Scale(6) G Scale(0.166666666667);
match Scale(delay) when delay > 0 then Scale(delay - 1);
match Scale(delay) when delay <= 0 then Scale;
