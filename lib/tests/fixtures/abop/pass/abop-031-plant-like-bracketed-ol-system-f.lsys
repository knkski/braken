# ID       : ABOP-031
# Name     : Plant-like bracketed OL system f
# Source   : chapter 1, book page 25, Fig. 1.24f
# Formalism: deterministic bracketed string
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | ω : X
# ABOP | p1    : X -> F-[[X]+X]+F[+FX]-X
# ABOP | p2    : F -> FF
#
axiom X;

match X then F Minus [ [ X ] Plus X ] Plus F [ Plus F X ] Minus X;
match F then F F;
