# ID       : ABOP-068
# Name     : Closed simple raceme
# Source   : chapter 3, book page 75, Closed raceme
# Formalism: nondeterministic bracketed string
# Parse    : pass
# Execute  : policy
# Note     : Parses; execution needs an explicit policy for unweighted alternatives.
#
# Original ABOP:
# ABOP | ω : a
# ABOP | p1    : a -> I[L]a
# ABOP | p2    : a -> I[L]A
# ABOP | p3    : A -> I[K]A
# ABOP | p4    : A -> K
#
axiom a;

match a then I [ L ] a;
match a then I [ L ] A;
match A then I [ K ] A;
match A then K;
