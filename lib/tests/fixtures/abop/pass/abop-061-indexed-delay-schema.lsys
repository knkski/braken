# ID       : ABOP-061
# Name     : Indexed delay schema
# Source   : chapter 3, book page 67, Delay mechanism
# Formalism: indexed deterministic string family
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | ω : a0
# ABOP | p_i   : a_i -> I[L]a_(i+1), 0 <= i <= n-1
# ABOP | p_n   : a_n -> I[L]A
# ABOP | p_n+1 : A -> K
#
# Parametric normalization of the indexed delay family.
let n = 7;
axiom a(0);
match a(i) when i < n then I [ L ] a(i + 1);
match a(i) when i = n then I [ L ] A;
match A then K;
