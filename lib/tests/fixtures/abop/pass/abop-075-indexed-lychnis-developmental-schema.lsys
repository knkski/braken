# ID       : ABOP-075
# Name     : Indexed Lychnis developmental schema
# Source   : chapter 3, book page 83, Lychnis schema
# Formalism: indexed deterministic bracketed family
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | ω : A7
# ABOP | p1    : A7 -> I[A0][A4]I K0
# ABOP | p2    : A_i -> A_(i+1), 0 <= i < 7
# ABOP | p3    : K_i -> K_(i+1), i >= 0
#
# Parametric normalization of indexed modules.
axiom A(7);
match A(t) when t = 7 then I [ A(0) ] [ A(4) ] I K(0);
match A(t) when t < 7 then A(t + 1);
match K(t) then K(t + 1);
