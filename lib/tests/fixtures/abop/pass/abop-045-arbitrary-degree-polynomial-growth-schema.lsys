# ID       : ABOP-045
# Name     : Arbitrary-degree polynomial growth schema
# Source   : chapter 1, book page 37, Polynomial growth schema
# Formalism: indexed deterministic string family
# Parse    : pass
# Execute  : pass
# Note     : The source-level indexed family is represented by one parametric rule.
#
# Original ABOP:
# ABOP | ω : a0
# ABOP | p_i   : a_i -> a_i a_(i+1), i >= 0
#
# Parametric normalization of the indexed rule family.
axiom a(0);
match a(i) then a(i) a(i + 1);
