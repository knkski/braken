# ID       : ABOP-056
# Name     : Aono–Kunii sympodial tree family
# Source   : chapter 2, book page 59, Fig. 2.7
# Formalism: parametric bracketed turtle string
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | #define r1 0.9
# ABOP | #define r2 0.7
# ABOP | #define a1 10
# ABOP | #define a2 60
# ABOP | #define wr 0.707
# ABOP | ω : A(1,10)
# ABOP | p1    : A(l,w) -> !(w)F(l)[&(a1)B(l*r1,w*wr)]/(180)[&(a2)B(l*r2,w*wr)]
# ABOP | p2    : B(l,w) -> !(w)F(l)[+(a1)$B(l*r1,w*wr)][-(a2)$B(l*r2,w*wr)]
#
let r1 = 0.9;
let r2 = 0.7;
let a1 = 10;
let a2 = 60;
let wr = 0.707;

axiom A(1,10);

match A(l,w) then Width(w) F(l) [ PitchDown(a1) B(l*r1,w*wr) ] RollRight(180) [ PitchDown(a2) B(l*r2,w*wr) ];
match B(l,w) then Width(w) F(l) [ Plus(a1) Horizontal B(l*r1,w*wr) ] [ Minus(a2) Horizontal B(l*r2,w*wr) ];
