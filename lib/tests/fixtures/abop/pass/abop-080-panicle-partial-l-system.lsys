# ID       : ABOP-080
# Name     : Panicle partial L-system
# Source   : chapter 3, book page 86, Panicle
# Formalism: nondeterministic bracketed string
# Parse    : pass
# Execute  : policy
# Note     : Parses; execution needs an explicit policy for unweighted alternatives.
#
# Original ABOP:
# ABOP | ω : a
# ABOP | p1    : a -> I[L]a
# ABOP | p2    : a -> I[L]A
# ABOP | p3    : A -> I[L][A]A
# ABOP | p4    : A -> K
#
axiom a;

match a then I [ L ] a;
match a then I [ L ] A;
match A then I [ L ] [ A ] A;
match A then K;
