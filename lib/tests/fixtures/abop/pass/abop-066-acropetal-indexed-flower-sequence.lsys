# ID       : ABOP-066
# Name     : Acropetal indexed flower sequence
# Source   : chapter 3, book page 73, Indexed flower-age modification
# Formalism: indexed deterministic string family
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | p3' : A -> I[I K0]A
# ABOP | p4  : K_i -> K_(i+1), i >= 0
#
# Standalone parametric normalization of the indexed flower-age patch.
axiom A;
match A then I [ I K(0) ] A;
match K(i) then K(i + 1);
