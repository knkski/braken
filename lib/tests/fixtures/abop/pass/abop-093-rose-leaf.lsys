# ID       : ABOP-093
# Name     : Rose leaf
# Source   : chapter 5, book page 125, Fig. 5.8
# Formalism: parametric bracketed turtle string
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | #define LA 5
# ABOP | #define RA 1.15
# ABOP | #define LB 1.3
# ABOP | #define RB 1.25
# ABOP | #define LC 3
# ABOP | #define RC 1.19
# ABOP | ω : [{A(0,0).}][{A(0,1).}]
# ABOP | p1    : A(t,d) : d=0 -> .G(LA,RA).[+B(t)G(LC,RC,t).}][+B(t){.]A(t+1,d)
# ABOP | p2    : A(t,d) : d=1 -> .G(LA,RA).[-B(t)G(LC,RC,t).}][-B(t){.]A(t+1,d)
# ABOP | p3    : B(t) : t>0 -> G(LB,RB)B(t-1)
# ABOP | p4    : G(s,r) -> G(s*r,r)
# ABOP | p5    : G(s,r,t) : t>1 -> G(s*r,r,t-1)
#
let LA = 5;
let RA = 1.15;
let LB = 1.3;
let RB = 1.25;
let LC = 3;
let RC = 1.19;

axiom [ PolygonBegin A(0,0) Vertex PolygonEnd ] [ PolygonBegin A(0,1) Vertex PolygonEnd ];

match A(t,d) when d=0 then Vertex G(LA,RA) Vertex [ Plus B(t) G(LC,RC,t) Vertex PolygonEnd ] [ Plus B(t) PolygonBegin Vertex ] A(t+1,d);
match A(t,d) when d=1 then Vertex G(LA,RA) Vertex [ Minus B(t) G(LC,RC,t) Vertex PolygonEnd ] [ Minus B(t) PolygonBegin Vertex ] A(t+1,d);
match B(t) when t>0 then G(LB,RB) B(t-1);
match G(s,r) then G(s*r,r);
match G(s,r,t) when t>1 then G(s*r,r,t-1);
