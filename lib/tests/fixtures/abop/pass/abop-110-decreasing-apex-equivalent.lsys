# ID       : ABOP-110
# Name     : Decreasing-apex equivalent
# Source   : chapter 8, book page 181, Eq. 8.2
# Formalism: parametric bracketed string
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | #define R 1.5
# ABOP | ω : A(1)
# ABOP | p1    : A(s) -> F(s)[+A(s/R)][-A(s/R)]F(s)A(s/R)
#
let R = 1.5;

axiom A(1);

match A(s) then F(s) [ Plus A(s/R) ] [ Minus A(s/R) ] F(s) A(s/R);
