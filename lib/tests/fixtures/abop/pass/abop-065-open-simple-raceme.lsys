# ID       : ABOP-065
# Name     : Open simple raceme
# Source   : chapter 3, book page 71, Eq. 3.3
# Formalism: nondeterministic bracketed string
# Parse    : pass
# Execute  : policy
# Note     : Parses; execution needs an explicit policy for unweighted alternatives.
#
# Original ABOP:
# ABOP | ω : a
# ABOP | p1    : a -> I[L]a
# ABOP | p2    : a -> I[L]A
# ABOP | p3    : A -> I[K]A
#
axiom a;

match a then I [ L ] a;
match a then I [ L ] A;
match A then I [ K ] A;
