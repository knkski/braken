# ID       : ABOP-095
# Name     : Compound leaf
# Source   : chapter 5, book page 128, Fig. 5.11
# Formalism: parametric bracketed string
# Parse    : pass
# Execute  : pass
#
# Original ABOP:
# ABOP | #define D 1
# ABOP | #define R 1.5
# ABOP | ω : A(0)
# ABOP | p1    : A(d) : d>0 -> A(d-1)
# ABOP | p2    : A(d) : d=0 -> F(1)[+A(D)][-A(D)]F(1)A(0)
# ABOP | p3    : F(a) -> F(a*R)
#
let D = 1;
let R = 1.5;

axiom A(0);

match A(d) when d>0 then A(d-1);
match A(d) when d=0 then F(1) [ Plus A(D) ] [ Minus A(D) ] F(1) A(0);
match F(a) then F(a*R);
