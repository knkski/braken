  "source": "# Adapted from ABOP-050, Anabaena catenula with heterocysts.\n# Source: The Algorithmic Beauty of Plants, L-system 1.1 / Fig. 1.35.\n# The final rule carries its printed complementary condition explicitly so\n# this focused fixture has deterministic behavior under the default policy.\n\nlet CH = 900;\nlet CT = 0.4;\nlet ST = 3.9;\n\nonly F;\n\naxiom Minus(90) F(0,0,CH) F(4,1,CH) F(0,0,CH);\n\nmatch F(s,t,c) when t = 1 and s >= 6 then F(s / 3 * 2,2,c) f(1) F(s / 3,1,c);\nmatch F(s,t,c) when t = 2 and s >= 6 then F(s / 3,2,c) f(1) F(s / 3 * 2,1,c);\nmatch F(s,t,c) left F(_,_,k) right F(_,_,r)\n    when s > ST or c > CT\n    then F(s + 0.1,t,c + 0.25 * (k + r - 3 * c));\nmatch F(s,t,c) left F(_,_,_) right F(_,_,_)\n    when not (s > ST or c > CT)\n    then F(0,0,CH) H(1);\nmatch H(s) when s < 3 then H(s * 1.1);\n",
