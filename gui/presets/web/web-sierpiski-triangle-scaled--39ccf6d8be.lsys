# JKUBIN | Grammar #91: sierpinski_triangle_scaled.ls
# JKUBIN | Description: Sierpiński triangle (scaled)
# JKUBIN | Variables: {F, G}
# JKUBIN | P: {
# JKUBIN | 	ω → F-G-G
# JKUBIN | 	F → F-G+F+G-F
# JKUBIN | 	G → >G<
# JKUBIN | 	F → F
# JKUBIN | 	G → F
# JKUBIN | }
# JKUBIN | n = 4, δ = 120°, scale = 2.0
#
let ANGLE = 120;
let SCALE = 2;

axiom F Minus G Minus G;

match F then F Minus G Plus F Plus G Minus F;
match G then ScaleLength G ScaleLengthInverse;
