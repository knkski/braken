let ANGLE = 15;
let SCALE = 1.8;

axiom X;

match X then Minus F [ Plus F ] [ Minus Minus Minus X ] Plus F Minus F [ Plus Plus Plus Plus X ] Minus X;
match F then ScaleLength WidthIncrease F WidthDecrease ScaleLengthInverse;
