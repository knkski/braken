let ANGLE = 72;
let SCALE = 2.62;

axiom [ F A ] Minus [ F A ] Minus [ F A ] Minus [ F A ] Minus [ F A ];

match A then ScaleLengthInverse [ F A ] Minus [ F A ] Minus [ F A ] Minus [ F A ] Minus [ F A ] ScaleLength;
