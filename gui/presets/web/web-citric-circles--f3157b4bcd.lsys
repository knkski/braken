let ANGLE = 36;

axiom F Y Plus Plus F Y Plus Plus F Y Plus Plus F Y Plus Plus F Y Plus Plus;

match F then nothing;
match X then F X Plus F X Plus F X [ Plus F X Plus F X Plus F X Plus F X ] Minus Minus Minus Minus F X Plus F X Plus F X;
match Y then F Y Plus F X Plus F X [ Plus F X Plus Plus F Y ] Minus Minus Minus Minus F X Plus F X Plus F X;
