# OFX | <rule>F -> F[F] -F +F [--F] +F -F</rule>
# OFX | <axiom>F-F-F-F</axiom>
# OFX | <maxDepth>4</maxDepth>
# OFX | <theta>90</theta>
# OFX | <bg_color>100, 162, 5, 255</bg_color>
