let ANGLE = 30;

axiom F X Minus F Y Minus F X Minus F Y Minus F X Minus F Y Minus F X Minus F Y Minus F X Minus F Y Minus F X Minus F Y Minus;

match F then nothing;
match X then Minus Minus F Y Plus Plus F X Plus Plus F Y Minus Minus;
match Y then Plus Plus F X Minus Minus F Y Minus Minus F X Plus Plus;
