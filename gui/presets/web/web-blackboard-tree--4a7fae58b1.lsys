# Note     : The source renderer draws every non-reserved letter; terminal model rules are metadata, not derivation productions.
#
# Original propfeds L-systems Renderer manual/gallery:
# SCHOLARLY | new LSystem('F', [
# SCHOLARLY |             'F=Y[++++++MF][-----NF][^^^^^OF][&&&&&PF]',
# SCHOLARLY |             'M=Z-M',
# SCHOLARLY |             'N=Z+N',
# SCHOLARLY |             'O=Z&O',
# SCHOLARLY |             'P=Z^P',
# SCHOLARLY |             'Y=Z-ZY+',
# SCHOLARLY |             'Z=ZZ'
# SCHOLARLY |         ], 8)
#
let ANGLE = 8;

axiom F;

match F then Y [ Plus Plus Plus Plus Plus Plus M F ] [ Minus Minus Minus Minus Minus N F ] [ PitchUp PitchUp PitchUp PitchUp PitchUp O F ] [ PitchDown PitchDown PitchDown PitchDown PitchDown P F ];
match M then HalfForward Minus M;
match N then HalfForward Plus N;
match O then HalfForward PitchDown O;
match P then HalfForward PitchUp P;
match Y then HalfForward Minus HalfForward Y Plus;
match Z then HalfForward HalfForward;
