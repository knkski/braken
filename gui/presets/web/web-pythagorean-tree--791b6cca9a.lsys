let ANGLE = 30;
let SCALE = 0.707106781;

axiom F Plus Plus Plus F Plus Plus Plus F Plus Plus Plus A;

match A then [ Minus Minus Minus Minus Minus ScaleLength ScaleLength F Plus Plus Plus A Plus Plus Plus F Plus Plus Plus F ] F [ Minus Minus Minus Minus Minus ScaleLength F Plus Plus Plus F Plus Plus Plus A Plus Plus Plus F ];
